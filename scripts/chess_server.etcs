#!/usr/bin/env etcs
#IMPORT ACE_ROOT/scripts

# Chess over HTTP, a default provided by ChessProvider

ChessProvider
ChessGame game
spawn game

# The equivalence class this board answers to. Any request path containing this
# segment routes here, so two people holding the same key land on the same
# board -- the whole matchmaking mechanism, shareable as a link or QR code.
Key game demo
Fen game

# Hand the board to the web tier. Detached rather than run: the server outlives
# this script, lives as long as the detached thread
detach chess_web.etcs game=game

