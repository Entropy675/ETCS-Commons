#!/usr/bin/env etcs
# Smoke test: spawn a board, read it, play a few legal moves, prove an
# illegal one is refused. Move echoes the resulting FEN, or "ILLEGAL".
ChessProvider
ChessGame game
spawn game

# starting position, and whose turn it is
Fen game
Status game

# 1. e4 e5  2. Nf3 Nc6
Move game e2e4
Move game e7e5
Move game g1f3
Move game b8c6
Fen game
# r1bqkbnr/pppp1ppp/2n5/4p3/4P3/5N2/PPPP1PPP/RNBQKB1R w KQkq - 2 3

# refused: the rook on a1 is boxed in, and it is white's move anyway.
# This is the anti-cheat surface -- rejection is the only outcome, there is
# no path into the engine that skips it.
Move game a1a5
# -> ILLEGAL
Move game e7e6
# -> ILLEGAL (black's pawn, white to move)

# Reset comes from EphemeralBase, not a work function -- back to move 1
Reset game
Fen game
