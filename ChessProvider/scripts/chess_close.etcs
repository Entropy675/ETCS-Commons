#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── CLOSE A GAME HOSTED ──────────────────────────────────────────────────────
#
#     run ChessProvider/scripts/chess_close.etcs share=<ChessShare> room=<Room>
#
# The room is the one chess_host.etcs made (room<n>). The hall entry is
# withdrawn (ChessShare::Leave), and the room goes with its links: every
# guest's record ends, which is how they learn the table is gone.

requires share [ChessShare]
requires room [Room]

share.Leave()
room.Delete()
