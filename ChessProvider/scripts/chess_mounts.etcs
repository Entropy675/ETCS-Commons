#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── THE CHESS PAGE'S FILES, for a site that serves it under a prefix ─────────
#
#     tree.SetMountPrefix(chess)
#     run ChessProvider/scripts/chess_mounts.etcs tree=tree
#     tree.SetMountPrefix()
#
# The wasm chess page (www/index.html) and what it fetches beside itself, each
# at the path it is fetched from -- the page's own list, kept here in the
# module the page belongs to, the way paint_mounts.etcs keeps Paint's, and
# serve_chess.etcs runs it with no prefix. The runtime (/wasm/) and the marks
# (/favicon/) are the site's, mounted once for every page.
#
# A SCRIPT'S NAME IS ITS OS PATH (modules.json, "_scripts"): the page stages
# each under the same relative path boot_chess.etcs spells in its `detach`
# lines, so the boot is written once for both substrates.

requires tree [FileHtmlPage]

tree.MountFile(index.html ACE_ROOT/modules/ChessProvider/scripts/www/index.html)
tree.MountFile(modules.json ACE_ROOT/modules/ChessProvider/scripts/www/modules.json)
tree.MountFile(boot_chess.etcs ACE_ROOT/modules/ChessProvider/scripts/www/boot_chess.etcs)
tree.MountFile(ChessProvider/scripts/chess_pointer.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_pointer.etcs)
tree.MountFile(ChessProvider/scripts/chess_keys.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_keys.etcs)
tree.MountFile(ChessProvider/scripts/chess_hall.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_hall.etcs)
tree.MountFile(ChessProvider/scripts/chess_host.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_host.etcs)
tree.MountFile(ChessProvider/scripts/chess_join.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_join.etcs)
tree.MountFile(ChessProvider/scripts/chess_leave.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_leave.etcs)
tree.MountFile(ChessProvider/scripts/chess_close.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_close.etcs)
tree.MountFile(ChessProvider/scripts/chess_judge.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_judge.etcs)
tree.MountFile(ChessProvider/scripts/chess_follow.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_follow.etcs)
tree.MountFile(ChessProvider/scripts/chess_emit.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_emit.etcs)
tree.MountFile(ChessProvider/scripts/chess_watch.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_watch.etcs)
tree.MountFile(ChessProvider/scripts/chess_mirror.etcs ACE_ROOT/modules/ChessProvider/scripts/chess_mirror.etcs)
tree.MountFile(RenderProvider/scripts/render_frames.etcs ACE_ROOT/modules/RenderProvider/scripts/render_frames.etcs)
tree.MountFile(shell ACE_ROOT/modules/ShellProvider/scripts/www/index.html)
