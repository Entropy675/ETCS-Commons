tree.MountFile(ChessProvider/ChessProvider/CChess/piece_images/white/PawnL.png ACE_ROOT/modules/ChessProvider/ChessProvider/CChess/piece_images/white/PawnL.png)
tree.MountFile(ChessProvider/ChessProvider/CChess/piece_images/white/PawnR.png ACE_ROOT/modules/ChessProvider/ChessProvider/CChess/piece_images/white/PawnR.png)
