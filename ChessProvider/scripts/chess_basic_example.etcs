#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── A BOARD, ALONE ───────────────────────────────────────────────────────────
#
#     etcs modules/ChessProvider/scripts/chess_basic_example.etcs
#
# The hotseat: no session, so the two seats are the two colours and the board
# is its own judge. Act <as> <verb> [<arg>] is the whole surface; a game
# between runtimes is the same verbs with the record in between
# (scripts/session/run.sh runs one).

spawn ChessProvider::ChessGame game
game.Fen()
game.Act(white move e2e4)
game.Act(black move e7e5)
game.Act(white move g1f3)
game.Act(black say a fine opening)
game.Status(white)
game.Chat()
game.History(0)
game.Hash()
