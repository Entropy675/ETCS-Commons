#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── A ROOM ON THIS SERVER: what other runtimes can reach ─────────────────────
#
# A LinkHub under the server takes WebSocket links at /link/<room>; a Room is
# the host end, and the only way in is what it publishes. Each guest runtime
# gets ONE link, and everything it does here -- binds, verbs, streams -- is
# multiplexed on it.
#
#   book       a Ledger -- lines appended by guests, in this runtime's order,
#              authored by the link they came over; a guest's surface starts
#              out holding the lines already here (ReflectRemote)
#   notes      guarded: a guest's surface must carry a Seal keyed the same, or
#              it cannot be bound, or nothing it sends passes
#   directory  a Lobby -- hosts elsewhere advertise here, and their entries
#              last as long as their links do
#
# Not a database: a Database is this runtime's own (the local frame), and no
# link binds one. What it holds reaches a guest through a type published here
# that reads it.
#
# A host that cannot listen (a browser tab, a machine behind NAT) hosts the
# same way through a server instead, and its guests dial the same address:
#
#     room.HostVia(wss://example.org/link/studio)

ensure NetworkProvider::HttpServer web
web.SetPort(8443)
web.EnableTLS(/tmp/etcs-cert.pem /tmp/etcs-key.pem)
web.spawn(NetworkProvider::LinkHub links)
web.Start()

spawn NetworkProvider::Ledger book
book.Append(opened by the host)

spawn NetworkProvider::Ledger notes
notes.spawn(NetworkProvider::Seal seal)
seal.Key(s3cret)

spawn NetworkProvider::Lobby directory

spawn NetworkProvider::Room room
room.SetName(studio)
room.Publish(book @book)
room.Publish(notes @notes)
room.Publish(directory @directory)
room.Host(@links studio)
room.Info()
