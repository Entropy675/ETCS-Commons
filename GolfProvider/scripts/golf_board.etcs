#!/usr/bin/env etcs
# Four rows of the board, in order. `run golf_board.etcs board=<Drawable2D> game=<GolfMatch>`
requires board [Drawable2D]
requires game [GolfMatch]
run golf_board_row.etcs board=board game=game
run golf_board_row.etcs board=board game=game
run golf_board_row.etcs board=board game=game
run golf_board_row.etcs board=board game=game
