#!/usr/bin/env etcs
# Four rows of the board, in order. `run golf_board.etcs eye=<Camera> game=<GolfMatch>`
requires eye [Camera]
requires game [GolfMatch]
run golf_board_row.etcs eye=eye game=game
run golf_board_row.etcs eye=eye game=game
run golf_board_row.etcs eye=eye game=game
run golf_board_row.etcs eye=eye game=game
