#!/usr/bin/env etcs
# A spring of the pool: the kart's -- a round plate and four arrows that close
# on its middle, drawn only; the throw is the match's.
#   run golf_spring.etcs world=<Scene3D> game=<GolfMatch> disc=<Mesh> dart=<Mesh>
requires world [Drawable3D]
requires game [GolfMatch]
requires disc [Mesh]
requires dart [Mesh]
world.spawn(RenderProvider::Scene3D plate)
plate.Create(1.0, 1.0, 1.0)
plate.SetMesh(@disc)
plate.SetAnchored(1)
world.spawn(RenderProvider::Scene3D a1)
world.spawn(RenderProvider::Scene3D a2)
world.spawn(RenderProvider::Scene3D a3)
world.spawn(RenderProvider::Scene3D a4)
run golf_arrow.etcs arrow=a1 dart=dart
run golf_arrow.etcs arrow=a2 dart=dart
run golf_arrow.etcs arrow=a3 dart=dart
run golf_arrow.etcs arrow=a4 dart=dart
game.AddSpringNode(@plate @a1 @a2 @a3 @a4)
