#!/usr/bin/env etcs
# HOLE 3, THE CLIMB: the cup is on a terrace two units up, at the top of a
# slope. Too soft and the ball rolls back down; and between the tee and the
# slope the green is cut away into a sand trap half a unit deep, in the
# straight line -- round it, or over it.
#
# Beside hole 2, fifty-six east of hole 1 (+x).
#
#   run golf_hole_3.etcs anchor=<the world> game=<GolfGame>
requires anchor [Drawable3D]
requires game [GolfGame]

# ── the green: z -4 to 16, top at y = 0, laid round the trap at (56, 0, 10) ──
anchor.spawn(RenderProvider::Scene3D green_s)
green_s.Create(16.0, 1.0, 11.6)
green_s.SetPosition(56.0, -0.5, 1.8)
run golf_surface.etcs part=green_s
anchor.spawn(RenderProvider::Scene3D green_n)
green_n.Create(16.0, 1.0, 3.6)
green_n.SetPosition(56.0, -0.5, 14.2)
run golf_surface.etcs part=green_n
anchor.spawn(RenderProvider::Scene3D green_w)
green_w.Create(5.6, 1.0, 4.8)
green_w.SetPosition(50.8, -0.5, 10.0)
run golf_surface.etcs part=green_w
anchor.spawn(RenderProvider::Scene3D green_e)
green_e.Create(5.6, 1.0, 4.8)
green_e.SetPosition(61.2, -0.5, 10.0)
run golf_surface.etcs part=green_e

# ── the trap: its floor half a unit down, sand ──────────────────────────────
anchor.spawn(RenderProvider::Scene3D trap)
trap.Create(4.8, 1.0, 4.8)
trap.SetPosition(56.0, -1.0, 10.0)
run golf_surface.etcs part=trap
trap.SetColor(0.78, 0.70, 0.45, 1.0)

# ── the slope: up over z 16 to 28, a unit thick ──────────────────────────────
anchor.spawn(RenderProvider::Scene3D slope)
slope.Create(16.0, 1.0, 12.166)
slope.SetPosition(56.0, 0.5068, 22.0822)
slope.Orient(1.0, 0.0, 0.0, -9.462)
run golf_surface.etcs part=slope

# ── the terrace: z 28 to 52, top at y = 2, a 0.7 gap about the hole at (56, 2, 44) ──
anchor.spawn(RenderProvider::Scene3D terrace_s)
terrace_s.Create(16.0, 3.0, 15.65)
terrace_s.SetPosition(56.0, 0.5, 35.825)
run golf_surface.etcs part=terrace_s
anchor.spawn(RenderProvider::Scene3D terrace_n)
terrace_n.Create(16.0, 3.0, 7.65)
terrace_n.SetPosition(56.0, 0.5, 48.175)
run golf_surface.etcs part=terrace_n
anchor.spawn(RenderProvider::Scene3D terrace_w)
terrace_w.Create(7.65, 3.0, 0.7)
terrace_w.SetPosition(51.825, 0.5, 44.0)
run golf_surface.etcs part=terrace_w
anchor.spawn(RenderProvider::Scene3D terrace_e)
terrace_e.Create(7.65, 3.0, 0.7)
terrace_e.SetPosition(60.175, 0.5, 44.0)
run golf_surface.etcs part=terrace_e

# ── the walls: bumpers round the green, tall beside the slope and the terrace ──
anchor.spawn(RenderProvider::Scene3D rail_w)
rail_w.Create(0.6, 1.5, 20.6)
rail_w.SetPosition(47.7, -0.25, 5.7)
run golf_wall.etcs part=rail_w
anchor.spawn(RenderProvider::Scene3D rail_e)
rail_e.Create(0.6, 1.5, 20.6)
rail_e.SetPosition(64.3, -0.25, 5.7)
run golf_wall.etcs part=rail_e
anchor.spawn(RenderProvider::Scene3D wall_w)
wall_w.Create(0.6, 3.5, 36.6)
wall_w.SetPosition(47.7, 0.75, 34.3)
run golf_wall.etcs part=wall_w
anchor.spawn(RenderProvider::Scene3D wall_e)
wall_e.Create(0.6, 3.5, 36.6)
wall_e.SetPosition(64.3, 0.75, 34.3)
run golf_wall.etcs part=wall_e
anchor.spawn(RenderProvider::Scene3D wall_s)
wall_s.Create(16.0, 1.5, 0.6)
wall_s.SetPosition(56.0, -0.25, -4.3)
run golf_wall.etcs part=wall_s
anchor.spawn(RenderProvider::Scene3D wall_n)
wall_n.Create(16.0, 3.5, 0.6)
wall_n.SetPosition(56.0, 0.75, 52.3)
run golf_wall.etcs part=wall_n

# ── the cup under the gap, and the tee ──────────────────────────────────────
anchor.spawn(RenderProvider::Scene3D cup)
cup.Create(0.7, 0.6, 0.7)
cup.SetPosition(56.0, 1.25, 44.0)
run golf_cup.etcs part=cup
anchor.spawn(RenderProvider::Scene3D tee)
tee.Create(0.6, 0.02, 0.6)
tee.SetPosition(56.0, 0.01, 0.0)
run golf_tee.etcs part=tee

game.AddHole(@cup, 56.0, 0.15, 0.0)
