#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# THE MATCH ON A CAMERA: the card, the frame counter, how to play and the
# little board, and the match bound to the eye it steers (on this runtime's
# own ball) -- the same for a window and a page.
#
#   run GolfProvider/scripts/golf_play.etcs game=game world=world eye=eye
#
# Then: drag your ball back to aim (the arrow is the shot, opposite the drag)
# and let go to putt -- along the ground it is on, wherever the camera is;
# drag anywhere else, or with the right button, to walk the camera round the
# ball; the wheel brings it in and out. Loft is the camera brought down while
# a pull is held (the right button with the left): the shot tips up off the
# ground by as much. E arms a power, and a left press and release puts it down
# where the pointer is; letting go of the right button while the left holds a
# pull or a power puts it down. In the lobby the menu is up: M folds it.

requires game [GolfMatch]
requires world [Drawable3D]
requires eye [Camera]

eye.spawn(RenderProvider::TextLabel card)
card.Create(20)
card.SetText(golf)
card.SetPosition(16, 16)
card.SetColor(1.0, 1.0, 0.85, 1.0)
card.SetBackground(0.0, 0.0, 0.0, 0.45)
card.SetPadding(6)
card.SetOrder(11)
# The frame counter, top right: this runtime's pictures a second.
eye.spawn(RenderProvider::TextLabel fps)
fps.Create(16)
fps.SetText(-- fps)
fps.SetPosition(950, 50)
fps.SetColor(0.75, 0.9, 0.8, 1.0)
fps.SetBackground(0.0, 0.0, 0.0, 0.35)
fps.SetPadding(4)
fps.SetOrder(11)
eye.spawn(RenderProvider::TextLabel howto)
howto.Create(16)
howto.SetText(drag your ball: putt / right-drag: look, and while pulling: loft / E then click: power / let go of right: cancel / wheel: zoom / M: menu)
howto.SetPosition(16, 724)
howto.SetColor(0.75, 0.9, 0.8, 1.0)
howto.SetBackground(0.0, 0.0, 0.0, 0.35)
howto.SetPadding(4)
howto.SetOrder(11)
# The little board, top right under the frame counter: eight rows.
run golf_board.etcs eye=eye game=game
run golf_board.etcs eye=eye game=game

game.BindWorld(@world)
game.BindCamera(@eye)
game.BindCard(@card)
game.BindFps(@fps)
# The lobby's menu, drawn in the canvas and centred in it: the course, how
# long a hole has, your colour and name, and the host's start. The page's own
# panel says the same lines, so either one moves the lobby.
eye.spawn(RenderProvider::Menu menu)
menu.Create(640, 430)
menu.SetOrder(20)
game.BindMenu(@menu)
game.SetPower(3.0, 12.0)
# Looking down 55 degrees. A pull starts along the ground whatever this is;
# bringing the camera down from where it was at the press is the loft.
game.SetOrbit(7.0, 0.0, 55.0)
