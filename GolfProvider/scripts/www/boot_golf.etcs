#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# GOLF, IN A BROWSER: the courses, the pools and the match, on the page served
# by ETCS (index.html beside this). The page names you, then practises, hosts
# or joins through the match (NetworkProvider/scripts/session_host.etcs,
# session_join.etcs) -- this file only builds what every one of those starts
# from, the same on every runtime that will share a match.
#
#     ./bin/etcs modules/GolfProvider/scripts/serve_golf.etcs
#     then open https://localhost:8443/
#
# The substrate is RenderProvider's 3D page's: no main.Run (the browser's loop
# is the page's), the camera composed directly with a Device child so the
# scene goes to the page's WebGPU device, drawing on the host when there is none.

spawn RenderProvider::Instance gpu
gpu.Create()
spawn WindowProvider::Window main
main.Create(1024, 768, ETCS golf)
main.spawn(RenderProvider::Surface view)
view.Create(@gpu)

spawn RenderProvider::Camera3D eye
eye.Create(1024, 768)
eye.SetPosition(0, 0)
eye.SetOrder(1)
eye.SetBackground(0.45, 0.62, 0.85, 1.0)
eye.SetLens(55.0, 0.05, 300.0)
# Cut for 4:3: wider sees more to the sides, taller more above and below.
eye.SetFit(1.3333)
eye.spawn(RenderProvider::Device dev)
dev.Create(@gpu)

# THE EYE FILLS THE WINDOW, whatever size it is given, and its labels and board
# keep their corners (golf_play.etcs).
spawn LayoutProvider::Layout hud
hud.Create(1024, 768)
hud.AddBox(@eye, 0, 1, 0.0, 1, 0.0)

spawn RenderProvider::Scene3D world
world.Create(1.0, 1.0, 1.0)
world.SetVisible(0)
eye.SetScene(@world)

# The match, named so the page and the terminal reach it (game.Scores(),
# game.Status()); the world builds the pools and the courses and hands them over.
# ENSURE: the OS entry (ETCS scripts/golf.etcs) makes it first, so the name is
# its global; run alone, as the page runs it, this makes it.
ensure GolfProvider::GolfMatch game
game.Create()
run GolfProvider/scripts/golf_world.etcs anchor=world game=game
run GolfProvider/scripts/golf_play.etcs game=game world=world eye=eye layout=hud
hud.Solve()
hud.FollowResize(@main)

view.Clear(0.02, 0.02, 0.03, 1.0)
view.Compose(@eye)
detach RenderProvider/scripts/render_frames.etcs view=view
detach GolfProvider/scripts/golf_pointer.etcs window=main game=game
detach GolfProvider/scripts/golf_keys.etcs window=main game=game
