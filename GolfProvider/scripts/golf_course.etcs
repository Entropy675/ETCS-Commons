#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# THE COURSE: three holes side by side, stated in the anchor's space -- a
# flat one, one that steps down a level, one that climbs a level past a sand
# trap (golf_hole_1.etcs to golf_hole_3.etcs). Everything here is a Scene3D,
# and what makes it a course is three statements of the Causal family
# (ontology/etcs_causal_constraints.md §11-§13):
#
#   the anchor's space has a field     anchor.SetGravity -- everything inside
#                                      falls, the ball included
#   the green, the walls are solid     SetSolid, and anchored: places, not
#                                      things; the ball is solid and free
#   the cup is a space of its own      a container under the gap, with its own
#                                      floor INSIDE it; a ball that drops in
#                                      fits its space and fit takes it in --
#                                      which is what holed means
#
# A hole's levels are the same solids: a terrace is a thick slab, a slope a
# slab turned about x, a trap a floor under a cut in the green. Each hole
# hands the game its cup and its tee (AddHole), in the order they are played.
#
#   run GolfProvider/scripts/golf_course.etcs anchor=world eye=eye game=game
#
# A script's names are its own, so the course hands its pieces to the game
# itself, at the end (golf_play.etcs): the ball and its shadow, the arrow and
# its shadow. Its parts are run by bare name: a script's own folder is looked
# in first, and that is the one path the same in a window and on a page,
# where #IMPORT's ACE_ROOT names the build machine's tree.

requires anchor [Drawable3D]
requires eye [Camera]
requires game [GolfGame]

anchor.SetGravity(0.0, -9.8, 0.0)
anchor.SetSpace(500.0)

# ── the holes, in the order they are played ────────────────────────────────
run golf_hole_1.etcs anchor=anchor game=game
run golf_hole_2.etcs anchor=anchor game=game
run golf_hole_3.etcs anchor=anchor game=game

# ── the ball: a sphere, solid and free ─────────────────────────────────────
anchor.spawn(RenderProvider::Mesh ball_shape)
ball_shape.Create()
ball_shape.Sphere(12)
anchor.spawn(RenderProvider::Scene3D ball)
ball.Create(0.3, 0.3, 0.3)
ball.SetMesh(@ball_shape)
ball.SetShape(sphere)
ball.SetSolid(0.45, 0.1)
ball.SetDamping(0.05)
ball.SetColor(0.97, 0.97, 0.95, 1.0)
ball.SetPosition(0.0, 0.15, 0.0)

# Its shadow: a dark disc the game lays on whatever is straight under it, so
# a ball in the air is seen to be in the air.
anchor.spawn(RenderProvider::Mesh disc_shape)
disc_shape.Create()
disc_shape.Cylinder(16)
anchor.spawn(RenderProvider::Scene3D ball_shadow)
ball_shadow.Create(0.36, 0.01, 0.36)
ball_shadow.SetMesh(@disc_shape)
ball_shadow.SetColor(0.05, 0.14, 0.07, 1.0)
ball_shadow.SetAnchored(1)
ball_shadow.SetVisible(0)

# ── the arrow a pull draws: not solid, held in place, hidden until a pull ───
anchor.spawn(RenderProvider::Mesh arrow_shape)
arrow_shape.Create()
arrow_shape.Arrow(0.3, 0.3)
anchor.spawn(RenderProvider::Scene3D arrow)
arrow.Create(0.15, 1.0, 0.15)
arrow.SetMesh(@arrow_shape)
arrow.SetAnchored(1)
arrow.SetVisible(0)
# Its shadow: the same arrow laid on the ground under it, so a pull shows how
# far it rises. Placed by the game with the arrow.
anchor.spawn(RenderProvider::Scene3D arrow_shadow)
arrow_shadow.Create(0.15, 1.0, 0.02)
arrow_shadow.SetMesh(@arrow_shape)
arrow_shadow.SetColor(0.05, 0.14, 0.07, 1.0)
arrow_shadow.SetAnchored(1)
arrow_shadow.SetVisible(0)

# ── the game on it ──────────────────────────────────────────────────────────
run golf_play.etcs game=game world=anchor eye=eye ball=ball arrow=arrow shadow=arrow_shadow under=ball_shadow
