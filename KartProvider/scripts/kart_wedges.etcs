#!/usr/bin/env etcs
# Six wedges of the pool. `run kart_wedges.etcs world=<Scene3D> battle=<KartBattle> shape=<Mesh>`
requires world [Drawable3D]
requires battle [KartBattle]
requires shape [Mesh]
run kart_wedge.etcs world=world battle=battle shape=shape
run kart_wedge.etcs world=world battle=battle shape=shape
