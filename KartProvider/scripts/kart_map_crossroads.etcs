#!/usr/bin/env etcs
# CROSSROADS: a cross of roads and a ring road between buildings of
# different heights, a ramp up onto the roof of six of them -- and over the
# whole north half, a roof: a deck above the buildings, a ramp up to it
# from each end of the north ring road, springs up through it from the road
# and the alleys, and every edge a way back down.
#   run kart_map_crossroads.etcs battle=<KartBattle>
# AddBlock <x> <z> <width> <depth> <height> <yaw>; AddRamp <x> <z> <yaw> <width>
# <up> <flat> <down> <height>; AddHill <x> <z> <radius> <height>; AddPad <x> <z>
# <yaw>; AddSpring <x> <z>; AddDeck <x> <z> <width> <depth> <height>; AddPit <x>
# <z> <width> <depth> <deep>; AddPickupUp <x> <z>, a box on the deck over the
# spot (KartArena.h). A ramp rises, and a pad pushes, toward its yaw (0 +z,
# 90 +x, 180 -z, 270 -x); what is in a pit stands on its floor.
requires battle [KartBattle]
battle.AddMap(crossroads)

# The buildings: two to a quarter, an alley seventeen wide between them. Six
# are ground (a ramp all level top): a wall to drive into, a roof to drive on,
# and a ramp up to each from the street outside, its lip at the wall -- every
# building in the south, and in the north the two low enough to drive on
# under the big roof. The other two are blocks, what that roof stands on.
# (A block's top is no road: a kart's sphere reaches below its wheels, and
# meets the block at its edge.)
battle.AddBlock(31.5, 45.0, 10.0, 28.0, 3.0, 0.0)
battle.AddBlock(-45.0, 58.5, 28.0, 10.0, 3.5, 0.0)
battle.AddRamp(58.5, 45.0, 0.0, 10.0, 0.0, 28.0, 0.0, 2.2)
battle.AddRamp(71.5, 45.0, 270.0, 8.0, 16.0, 0.0, 0.0, 2.2)
battle.AddRamp(-45.0, 31.5, 0.0, 28.0, 0.0, 10.0, 0.0, 2.5)
battle.AddRamp(-45.0, 18.5, 0.0, 8.0, 16.0, 0.0, 0.0, 2.5)
battle.AddRamp(45.0, -31.5, 0.0, 28.0, 0.0, 10.0, 0.0, 3.5)
battle.AddRamp(45.0, -16.5, 180.0, 8.0, 20.0, 0.0, 0.0, 3.5)
battle.AddRamp(45.0, -58.5, 0.0, 28.0, 0.0, 10.0, 0.0, 2.0)
battle.AddRamp(45.0, -71.5, 0.0, 8.0, 16.0, 0.0, 0.0, 2.0)
battle.AddRamp(-31.5, -45.0, 0.0, 10.0, 0.0, 28.0, 0.0, 2.0)
battle.AddRamp(-18.5, -45.0, 270.0, 8.0, 16.0, 0.0, 0.0, 2.0)
battle.AddRamp(-58.5, -45.0, 0.0, 10.0, 0.0, 28.0, 0.0, 3.0)
battle.AddRamp(-73.5, -45.0, 90.0, 8.0, 20.0, 0.0, 0.0, 3.0)
# Planters on the junction's corners, clear of both roads' middles.
battle.AddBlock(18.0, 18.0, 4.0, 4.0, 1.0, 0.0)
battle.AddBlock(-18.0, 18.0, 4.0, 4.0, 1.0, 0.0)
battle.AddBlock(18.0, -18.0, 4.0, 4.0, 1.0, 0.0)
battle.AddBlock(-18.0, -18.0, 4.0, 4.0, 1.0, 0.0)
# Up to the roof: on the north ring road, a ramp in from each end of it,
# thirty-six long, toward the middle.
battle.AddRamp(57.0, 72.0, 270.0, 12.0, 36.0, 0.0, 0.0, 5.1)
battle.AddRamp(-57.0, 72.0, 90.0, 12.0, 36.0, 0.0, 0.0, 5.1)
# The roof: a hundred and fifty by sixty-six over the north road, both
# northern quarters and their alleys, its two north corners cut away over the
# ramps.
battle.AddDeck(0.0, 39.0, 150.0, 54.0, 5.1)
battle.AddDeck(0.0, 72.0, 78.0, 12.0, 5.1)
# Up through it: springs on the north road and in each alley.
battle.AddSpring(0.0, 60.0)
battle.AddSpring(45.0, 33.0)
battle.AddSpring(-27.0, 45.0)

# On the roads, each facing the middle down its road: the corners face a
# block, so none is a spawn.
battle.AddSpawn(0.0, -81.0)
battle.AddSpawn(0.0, 81.0)
battle.AddSpawn(-81.0, 0.0)
battle.AddSpawn(81.0, 0.0)
battle.AddSpawn(0.0, -36.0)
battle.AddSpawn(0.0, 36.0)
battle.AddSpawn(-36.0, 0.0)
battle.AddSpawn(36.0, 0.0)

# Pads on the cross street toward the junction, and round the ring road.
battle.AddPad(-63.0, 0.0, 90.0)
battle.AddPad(63.0, 0.0, 270.0)
battle.AddPad(78.0, 30.0, 0.0)
battle.AddPad(-78.0, -30.0, 180.0)
battle.AddPad(15.0, 84.0, 270.0)
battle.AddPad(30.0, -78.0, 90.0)
# Springs on the ring road.
battle.AddSpring(81.0, -18.0)
battle.AddSpring(-81.0, 21.0)

# Boxes on the roads, and on the roof.
battle.AddPickup(0.0, 0.0)
battle.AddPickup(45.0, 0.0)
battle.AddPickup(-45.0, 0.0)
battle.AddPickup(0.0, 45.0)
battle.AddPickup(0.0, -45.0)
battle.AddPickup(-45.0, -45.0)
battle.AddPickupUp(45.0, 45.0)
battle.AddPickupUp(-45.0, 45.0)

# No bare stretches (KartArena::Faults, bare): where the ground ran on with
# nothing on it, a bump to hop, a pad along the wall, a platform with a spring
# beside it and a box on top, or a box.
battle.AddHill(-88.0, -88.0, 6.0, 1.2)
battle.AddPad(-16.0, -88.0, 90.0)
battle.AddDeck(72.0, -88.0, 8.0, 8.0, 2.5)
battle.AddSpring(72.0, -95.0)
battle.AddPickupUp(72.0, -88.0)
battle.AddPad(86.0, -52.0, 0.0)
battle.AddPickup(-48.0, -86.0)
