#!/usr/bin/env etcs
# HILLS: high ground and low. The south half of the arena is sunk -- hills
# and boulders down there too, three ramps up its north edge and springs
# -- and on the high ground a ridge to ride over, two jumps, and a deck in
# the air over the north-east with a hill under it.
#   run kart_map_hills.etcs battle=<KartBattle>
# AddBlock <x> <z> <width> <depth> <height> <yaw>; AddRamp <x> <z> <yaw> <width>
# <up> <flat> <down> <height>; AddHill <x> <z> <radius> <height>; AddPad <x> <z>
# <yaw>; AddSpring <x> <z>; AddDeck <x> <z> <width> <depth> <height>; AddPit <x>
# <z> <width> <depth> <deep>; AddPickupUp <x> <z>, a box on the deck over the
# spot (KartArena.h). A ramp rises, and a pad pushes, toward its yaw (0 +z,
# 90 +x, 180 -z, 270 -x); what is in a pit stands on its floor.
requires battle [KartBattle]
battle.AddMap(hills)

# The low ground: the south, the whole arena wide.
battle.AddPit(0.0, -36.0, 128.0, 56.0, 2.5)
# Out of it: ramps up its north edge, west, middle and east.
battle.AddRamp(-52.0, -14.5, 0.0, 10.0, 13.0, 0.0, 0.0, 2.5)
battle.AddRamp(0.0, -14.5, 0.0, 10.0, 13.0, 0.0, 0.0, 2.5)
battle.AddRamp(48.0, -14.5, 0.0, 10.0, 13.0, 0.0, 0.0, 2.5)
# Hills: three down there, three up here -- each dome, drawn on under the
# ground twice its radius out, kept over the arena's floor.
battle.AddHill(-22.0, -28.0, 18.0, 2.7)
battle.AddHill(22.0, -30.0, 14.0, 2.0)
battle.AddHill(44.0, -44.0, 10.0, 1.8)
battle.AddHill(28.0, 24.0, 14.0, 2.6)
battle.AddHill(-18.0, 30.0, 14.0, 2.1)
battle.AddHill(-44.0, 44.0, 10.0, 1.8)
# The ridge: a deck on the diagonal, up from the south-east, down to the north-west.
battle.AddRamp(-4.0, 16.0, 315.0, 8.0, 10.0, 12.0, 10.0, 2.4)
# Jumps, toward the middle.
battle.AddRamp(-40.0, 4.0, 90.0, 8.0, 12.0, 0.0, 0.0, 2.8)
battle.AddRamp(40.0, 0.0, 270.0, 8.0, 12.0, 0.0, 0.0, 2.8)
# Boulders.
battle.AddBlock(-4.0, -44.0, 5.0, 5.0, 1.5, 45.0)
battle.AddBlock(8.0, 40.0, 5.0, 5.0, 1.5, 45.0)
battle.AddBlock(54.0, 10.0, 5.0, 5.0, 1.5, 45.0)
battle.AddBlock(-44.0, -24.0, 5.0, 5.0, 1.5, 45.0)
# Up to the storey: a ramp twenty-four long in from its north edge, a pad at its foot.
battle.AddRamp(48.0, 40.0, 180.0, 8.0, 24.0, 0.0, 0.0, 5.0)
battle.AddPad(48.0, 57.0, 180.0)
# The upper storey: over the north-east, the east hill under it, its
# north-east corner cut away over the ramp.
battle.AddDeck(28.0, 16.0, 48.0, 24.0, 5.0)
battle.AddDeck(24.0, 40.0, 40.0, 24.0, 5.0)
# Springs: under the deck, and down in the low ground.
battle.AddSpring(14.0, 46.0)
battle.AddSpring(44.0, 10.0)
battle.AddSpring(20.0, -52.0)
battle.AddSpring(-12.0, -54.0)
# Pads on the flats: one up here, and down there one toward the east ramp.
battle.AddPad(-46.0, 18.0, 0.0)
battle.AddPad(-24.0, -50.0, 90.0)
battle.AddPad(48.0, -27.0, 0.0)

battle.AddSpawn(0.0, -52.0)
battle.AddSpawn(0.0, 52.0)
battle.AddSpawn(-52.0, 0.0)
battle.AddSpawn(52.0, 0.0)
battle.AddSpawn(36.0, -36.0)
battle.AddSpawn(-36.0, 36.0)
battle.AddSpawn(36.0, 36.0)
battle.AddSpawn(-44.0, -44.0)

# Boxes: on the hills, and on the deck.
battle.AddPickup(-22.0, -28.0)
battle.AddPickup(28.0, 24.0)
battle.AddPickup(-18.0, 30.0)
battle.AddPickup(22.0, -30.0)
battle.AddPickup(44.0, -44.0)
battle.AddPickup(-44.0, 44.0)
battle.AddPickupUp(28.0, 16.0)
battle.AddPickupUp(24.0, 40.0)
