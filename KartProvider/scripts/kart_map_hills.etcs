#!/usr/bin/env etcs
# HILLS: six rolling hills with a box on every top, a ridge across the
# middle with a box on its crest, two jumps, and boulders to hide behind --
# what you can see over is what can see you.
#   run kart_map_hills.etcs battle=<KartBattle>
# AddBlock <x> <z> <width> <depth> <height> <yaw>; AddRamp <x> <z> <yaw> <width>
# <up> <flat> <down> <height>; AddHill <x> <z> <radius> <height>; AddPad <x> <z>
# <yaw> (KartArena.h). A ramp rises, and a pad pushes, toward its yaw (0 +z,
# 90 +x, 180 -z, 270 -x).
requires battle [KartBattle]
battle.AddMap(hills)

battle.AddHill(-11.0, -9.0, 9.0, 1.8)
battle.AddHill(13.0, 7.0, 9.0, 2.0)
battle.AddHill(-9.0, 15.0, 7.0, 1.4)
battle.AddHill(11.0, -15.0, 7.0, 1.3)
battle.AddHill(25.0, -25.0, 6.0, 1.2)
battle.AddHill(-25.0, 25.0, 6.0, 1.2)
# The ridge: a deck on the diagonal, up from the south-east, down to the north-west.
battle.AddRamp(0.0, 0.0, 315.0, 4.0, 5.0, 6.0, 5.0, 1.6)
battle.AddRamp(-20.0, 2.0, 90.0, 4.0, 6.0, 0.0, 0.0, 1.4)
battle.AddRamp(20.0, -2.0, 270.0, 4.0, 6.0, 0.0, 0.0, 1.4)
# Boulders.
battle.AddBlock(-4.0, -20.0, 2.5, 2.5, 1.5, 45.0)
battle.AddBlock(4.0, 20.0, 2.5, 2.5, 1.5, 45.0)
battle.AddBlock(22.0, 14.0, 2.5, 2.5, 1.5, 45.0)
battle.AddBlock(-22.0, -12.0, 2.5, 2.5, 1.5, 45.0)

# Pads on the flats between the hills.
battle.AddPad(16.0, 26.0, 270.0)
battle.AddPad(-12.0, -25.0, 90.0)
battle.AddPad(-23.0, 9.0, 0.0)
battle.AddPad(24.0, -11.0, 180.0)

battle.AddSpawn(0.0, -26.0)
battle.AddSpawn(0.0, 26.0)
battle.AddSpawn(-26.0, 0.0)
battle.AddSpawn(26.0, 0.0)
battle.AddSpawn(18.0, -18.0)
battle.AddSpawn(-18.0, 18.0)
battle.AddSpawn(18.0, 18.0)
battle.AddSpawn(-18.0, -18.0)

battle.AddPickup(0.0, 0.0)
battle.AddPickup(-11.0, -9.0)
battle.AddPickup(13.0, 7.0)
battle.AddPickup(-9.0, 15.0)
battle.AddPickup(11.0, -15.0)
battle.AddPickup(25.0, -25.0)
battle.AddPickup(-25.0, 25.0)
battle.AddPickup(0.0, -14.0)
