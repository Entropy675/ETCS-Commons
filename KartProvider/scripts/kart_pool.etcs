#!/usr/bin/env etcs
# THE POOLS: everything the battle shows and hides as the trace goes -- eight
# karts; the blocks, wedges, slabs, domes, pads and springs a map is drawn
# with; the power-up boxes, the shots in the air and the bursts' fire. Each is
# the battle's from the moment it is made, held, and solid to nothing but the
# karts' bodies and the blocks (KartBattle.h).
#   run kart_pool.etcs world=<Scene3D> battle=<KartBattle>
requires world [Drawable3D]
requires battle [KartBattle]

# One tyre for all thirty-two wheels, one ball for every burst and hill --
# children of the world, since a shape is named by where it is (Scene3D::SetMesh).
world.spawn(RenderProvider::Mesh tyre)
tyre.Create()
tyre.Cylinder(14)
world.spawn(RenderProvider::Mesh ball)
ball.Create()
ball.Sphere(12)
# ...and one arrow for every pad's three: a short shaft, a broad head.
world.spawn(RenderProvider::Mesh dart)
dart.Create()
dart.Arrow(0.45, 0.55)
# ...and one wedge for every ramp's slopes.
world.spawn(RenderProvider::Mesh slope)
run kart_wedge_shape.etcs shape=slope

run kart_car.etcs world=world battle=battle tyre=tyre
run kart_car.etcs world=world battle=battle tyre=tyre
run kart_car.etcs world=world battle=battle tyre=tyre
run kart_car.etcs world=world battle=battle tyre=tyre
run kart_car.etcs world=world battle=battle tyre=tyre
run kart_car.etcs world=world battle=battle tyre=tyre
run kart_car.etcs world=world battle=battle tyre=tyre
run kart_car.etcs world=world battle=battle tyre=tyre

# The map's scenery in a holder of its own -- every piece below that is drawn
# and never touched, the blocks apart (a kart meets a block, and meets only
# what is beside it in the world). Between maps it is still, skipped by the
# interaction and drawn as one mesh (kart_holder.etcs).
world.spawn(RenderProvider::Scene3D scenery)
run kart_holder.etcs holder=scenery

# The map in play: twenty-four blocks, twenty-four wedges (a ramp's slopes,
# up to two), forty-two slabs (a ramp's level top, each piece of a deck, a
# pit's floor and walls, the floor laid round a pit), ten domes. A map that
# needs more of one than this is told so by battle.Faults().
run kart_blocks.etcs world=world battle=battle
run kart_blocks.etcs world=world battle=battle
run kart_blocks.etcs world=world battle=battle
run kart_wedges.etcs world=scenery battle=battle shape=slope
run kart_wedges.etcs world=scenery battle=battle shape=slope
run kart_wedges.etcs world=scenery battle=battle shape=slope
run kart_wedges.etcs world=scenery battle=battle shape=slope
run kart_slabs.etcs world=scenery battle=battle
run kart_slabs.etcs world=scenery battle=battle
run kart_slabs.etcs world=scenery battle=battle
run kart_slabs.etcs world=scenery battle=battle
run kart_slabs.etcs world=scenery battle=battle
run kart_slabs.etcs world=scenery battle=battle
run kart_slabs.etcs world=scenery battle=battle
run kart_dome.etcs world=scenery battle=battle ball=ball
run kart_dome.etcs world=scenery battle=battle ball=ball
run kart_dome.etcs world=scenery battle=battle ball=ball
run kart_dome.etcs world=scenery battle=battle ball=ball
run kart_dome.etcs world=scenery battle=battle ball=ball
run kart_dome.etcs world=scenery battle=battle ball=ball
run kart_dome.etcs world=scenery battle=battle ball=ball
run kart_dome.etcs world=scenery battle=battle ball=ball
run kart_dome.etcs world=scenery battle=battle ball=ball
run kart_dome.etcs world=scenery battle=battle ball=ball
run kart_arcs.etcs world=scenery battle=battle
run kart_arcs.etcs world=scenery battle=battle
run kart_slick.etcs world=world battle=battle
run kart_slick.etcs world=world battle=battle
run kart_slick.etcs world=world battle=battle
run kart_slick.etcs world=world battle=battle
run kart_slick.etcs world=world battle=battle
run kart_slick.etcs world=world battle=battle

# Sixteen pads, as many as the busiest map has.
run kart_pads.etcs world=world ground=scenery battle=battle dart=dart
run kart_pads.etcs world=world ground=scenery battle=battle dart=dart
run kart_pads.etcs world=world ground=scenery battle=battle dart=dart
run kart_pads.etcs world=world ground=scenery battle=battle dart=dart

# Eight springs: a tyre's shape laid flat is the plate.
run kart_springs.etcs world=world ground=scenery battle=battle disc=tyre dart=dart
run kart_springs.etcs world=world ground=scenery battle=battle disc=tyre dart=dart
run kart_springs.etcs world=world ground=scenery battle=battle disc=tyre dart=dart
run kart_springs.etcs world=world ground=scenery battle=battle disc=tyre dart=dart

# As many boxes as the busiest map has spots: twenty.
run kart_pickups.etcs world=world battle=battle
run kart_pickups.etcs world=world battle=battle
run kart_pickups.etcs world=world battle=battle
run kart_pickups.etcs world=world battle=battle
run kart_pickups.etcs world=world battle=battle

# Thirty-two shots drawn at once (more fly, undrawn: a rocket or a round
# lives until it has crossed the arena).
run kart_shots.etcs world=world battle=battle
run kart_shots.etcs world=world battle=battle
run kart_shots.etcs world=world battle=battle
run kart_shots.etcs world=world battle=battle
# Sixty-four effects: a smoke bomb's ring is ten of them, a slick and its
# drops four, a homing rocket's wisps take what is spare.
run kart_fxs.etcs world=world battle=battle ball=ball
run kart_fxs.etcs world=world battle=battle ball=ball
run kart_fxs.etcs world=world battle=battle ball=ball
run kart_fxs.etcs world=world battle=battle ball=ball
run kart_fxs.etcs world=world battle=battle ball=ball
run kart_fxs.etcs world=world battle=battle ball=ball
run kart_fxs.etcs world=world battle=battle ball=ball
run kart_fxs.etcs world=world battle=battle ball=ball
# ...and three shockwaves at once, on one ring.
world.spawn(RenderProvider::Mesh hoop)
hoop.Create()
run kart_ring.etcs world=world battle=battle ring=hoop
run kart_ring.etcs world=world battle=battle ring=hoop
run kart_ring.etcs world=world battle=battle ring=hoop

# Three bursts burning at once: each a core, three shells of its tree of
# fire and fourteen puffs of the smoke it leaves. The battle bakes its eight
# trees into twenty-four meshes, three a tree, and copies a burst's into its
# shells' own nine, bent to the ground round it (KartBattle.h, a burst); the
# smoke is on one ember shape, a ball smooth enough to read as round at a
# puff's size.
run kart_fire_meshes.etcs world=world battle=battle
run kart_fire_meshes.etcs world=world battle=battle
run kart_fire_meshes.etcs world=world battle=battle
run kart_burst_meshes.etcs world=world battle=battle
world.spawn(RenderProvider::Mesh ember)
ember.Create()
ember.Sphere(6)
run kart_blast.etcs world=world battle=battle ball=ball
run kart_blast.etcs world=world battle=battle ball=ball
run kart_blast.etcs world=world battle=battle ball=ball
run kart_sparks.etcs world=world battle=battle ember=ember
run kart_smokes.etcs world=world battle=battle ember=ember
run kart_smokes.etcs world=world battle=battle ember=ember
run kart_smokes.etcs world=world battle=battle ember=ember
