#!/usr/bin/env etcs
# A wedge of the pool: a ramp's slope, solid to the ground, drawn only -- the
# ground is the battle's height (KartArena.h), which sizes, turns and colours it.
#   run kart_wedge.etcs world=<Scene3D> battle=<KartBattle> shape=<Mesh>
requires world [Drawable3D]
requires battle [KartBattle]
requires shape [Mesh]
world.spawn(RenderProvider::Scene3D wedge)
wedge.Create(1.0, 1.0, 1.0)
wedge.SetMesh(@shape)
wedge.SetAnchored(1)
battle.AddWedgeNode(@wedge)
