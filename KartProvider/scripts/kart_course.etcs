#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# THE TRACK: a walled rectangle round an island, its corners cut, and a pool of
# eight karts in the pit -- all Scene3D, in the anchor's space.
#
#   run KartProvider/scripts/kart_course.etcs anchor=world race=race
#
# What makes it a race track is two statements of the Causal family
# (ontology/etcs_causal_constraints.md §12-§13) and one of RenderProvider's:
#
#   the walls and the island are solid   anchored solids: the karts bump them
#   the karts are solid                  spheres to everything, drawn as a
#                                        body on four wheels
#   the world is driven                  SetDriven: only the race steps it, from
#                                        its record -- never a picture, so every
#                                        runtime's copy is the same world
#
# No field: the track is flat and the karts stay at their height. The line is
# across the near straight at x = 0 and the half-way gate across the far one
# (KartRace::lapLocked reads them there). Its parts are run by bare name (a
# script's own folder first: the same path in a window and on a page).

requires anchor [Drawable3D]
requires race [KartRace]

anchor.SetSpace(500.0)
anchor.SetDriven(1)

# ── the ground: not solid, a picture of where to drive ─────────────────────
anchor.spawn(RenderProvider::Scene3D ground)
ground.Create(70.0, 0.1, 50.0)
ground.SetPosition(0.0, -0.05, 0.0)
ground.SetColor(0.30, 0.31, 0.33, 1.0)
ground.SetAnchored(1)

# ── the walls: 60 by 40 inside, corners cut at 45 degrees ──────────────────
anchor.spawn(RenderProvider::Scene3D wall_n)
wall_n.Create(62.0, 1.0, 1.0)
wall_n.SetPosition(0.0, 0.5, 20.5)
anchor.spawn(RenderProvider::Scene3D wall_s)
wall_s.Create(62.0, 1.0, 1.0)
wall_s.SetPosition(0.0, 0.5, -20.5)
anchor.spawn(RenderProvider::Scene3D wall_e)
wall_e.Create(1.0, 1.0, 42.0)
wall_e.SetPosition(30.5, 0.5, 0.0)
anchor.spawn(RenderProvider::Scene3D wall_w)
wall_w.Create(1.0, 1.0, 42.0)
wall_w.SetPosition(-30.5, 0.5, 0.0)
anchor.spawn(RenderProvider::Scene3D cut_ne)
cut_ne.Create(1.0, 1.0, 8.5)
cut_ne.SetPosition(27.0, 0.5, 17.0)
cut_ne.Orient(0.0, 1.0, 0.0, -45.0)
anchor.spawn(RenderProvider::Scene3D cut_se)
cut_se.Create(1.0, 1.0, 8.5)
cut_se.SetPosition(27.0, 0.5, -17.0)
cut_se.Orient(0.0, 1.0, 0.0, 45.0)
anchor.spawn(RenderProvider::Scene3D cut_nw)
cut_nw.Create(1.0, 1.0, 8.5)
cut_nw.SetPosition(-27.0, 0.5, 17.0)
cut_nw.Orient(0.0, 1.0, 0.0, 45.0)
anchor.spawn(RenderProvider::Scene3D cut_sw)
cut_sw.Create(1.0, 1.0, 8.5)
cut_sw.SetPosition(-27.0, 0.5, -17.0)
cut_sw.Orient(0.0, 1.0, 0.0, -45.0)
run kart_wall.etcs part=wall_n
run kart_wall.etcs part=wall_s
run kart_wall.etcs part=wall_e
run kart_wall.etcs part=wall_w
run kart_wall.etcs part=cut_ne
run kart_wall.etcs part=cut_se
run kart_wall.etcs part=cut_nw
run kart_wall.etcs part=cut_sw

# ── the island: 36 by 16, grass, solid ─────────────────────────────────────
anchor.spawn(RenderProvider::Scene3D island)
island.Create(36.0, 0.6, 16.0)
island.SetPosition(0.0, 0.3, 0.0)
island.SetColor(0.24, 0.52, 0.22, 1.0)
island.SetAnchored(1)
island.SetSolid(0.4, 0.0)

# ── the line and the half-way gate: marks, not solid ───────────────────────
anchor.spawn(RenderProvider::Scene3D line)
line.Create(0.6, 0.02, 12.0)
line.SetPosition(0.0, 0.01, -14.0)
line.SetColor(0.95, 0.95, 0.92, 1.0)
line.SetAnchored(1)
anchor.spawn(RenderProvider::Scene3D gate)
gate.Create(0.3, 0.02, 12.0)
gate.SetPosition(0.0, 0.01, 14.0)
gate.SetColor(0.85, 0.75, 0.25, 1.0)
gate.SetAnchored(1)

# ── the pool: eight karts, each the race's from the moment it is made ──────
# One tyre shape for all thirty-two wheels.
spawn RenderProvider::Mesh tyre
tyre.Create()
tyre.Cylinder(14)
run kart_car.etcs world=anchor race=race tyre=tyre
run kart_car.etcs world=anchor race=race tyre=tyre
run kart_car.etcs world=anchor race=race tyre=tyre
run kart_car.etcs world=anchor race=race tyre=tyre
run kart_car.etcs world=anchor race=race tyre=tyre
run kart_car.etcs world=anchor race=race tyre=tyre
run kart_car.etcs world=anchor race=race tyre=tyre
run kart_car.etcs world=anchor race=race tyre=tyre
