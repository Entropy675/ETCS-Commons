#!/usr/bin/env etcs
# The pointer edge: a drag with the right button looks round the kart.
# Detached: a stream edge blocks the thread that states it.
#   detach KartProvider/scripts/kart_pointer.etcs window=main battle=battle
requires window [Window]
requires battle [KartBattle]
window.ProducePointer() -> battle.ConsumePointer()
