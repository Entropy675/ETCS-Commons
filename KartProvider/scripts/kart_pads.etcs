#!/usr/bin/env etcs
# Four pads of the pool. `run kart_pads.etcs world=<Scene3D> battle=<KartBattle> dart=<Mesh>`
requires world [Drawable3D]
requires battle [KartBattle]
requires dart [Mesh]
run kart_pad.etcs world=world battle=battle dart=dart
run kart_pad.etcs world=world battle=battle dart=dart
run kart_pad.etcs world=world battle=battle dart=dart
run kart_pad.etcs world=world battle=battle dart=dart
