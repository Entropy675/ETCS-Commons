#!/usr/bin/env etcs
# THE RIM: mountains round the arena, on and behind its walls -- a row of
# peaks down each side and one on every corner, each a rough ball sunk to its
# middle in the wall's top, so what shows is a crag. Drawn only: what a kart
# that goes over the wall meets is the battle's own rim (KartBattle.h, OVER
# THE WALL -- ground that climbs from the wall's top, with no grip, so it
# slides back in), and these are where that ground is.
#   run kart_rim.etcs anchor=<Scene3D>
requires anchor [Drawable3D]
# A ball of few faces: a peak with edges to it.
anchor.spawn(RenderProvider::Mesh crag)
crag.Create()
crag.Sphere(5)

anchor.spawn(RenderProvider::Scene3D peak_1)
peak_1.Create(18.5, 22.5, 10.4)
peak_1.SetMesh(@crag)
peak_1.SetPosition(-88.5, 4.0, 100.4)
peak_1.SetColor(0.41, 0.39, 0.37, 1.0)
peak_1.SetAnchored(1)

