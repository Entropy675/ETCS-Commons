#!/usr/bin/env etcs
# A spring of the pool: a round plate on the ground and four arrows that close
# on its middle, drawn only -- the throw is the battle's (KartBattle.h), which
# sizes and colours it all and moves the arrows.
#   run kart_spring.etcs world=<Scene3D> battle=<KartBattle> disc=<Mesh> dart=<Mesh>
requires world [Drawable3D]
requires battle [KartBattle]
requires disc [Mesh]
requires dart [Mesh]
world.spawn(RenderProvider::Scene3D plate)
plate.Create(1.0, 1.0, 1.0)
plate.SetMesh(@disc)
plate.SetAnchored(1)
world.spawn(RenderProvider::Scene3D a1)
world.spawn(RenderProvider::Scene3D a2)
world.spawn(RenderProvider::Scene3D a3)
world.spawn(RenderProvider::Scene3D a4)
run kart_arrow.etcs arrow=a1 dart=dart
run kart_arrow.etcs arrow=a2 dart=dart
run kart_arrow.etcs arrow=a3 dart=dart
run kart_arrow.etcs arrow=a4 dart=dart
battle.AddSpringNode(@plate @a1 @a2 @a3 @a4)
