#!/usr/bin/env etcs
# A TRIM of a kart: one colour of a built vehicle's look that is not the team
# colour, drawn over the body in its own (KartBattle::lookLocked). Held in the
# body's frame and turned with it after every step, hidden until a look has
# that colour.
#   run kart_trim.etcs kart=<Scene3D> battle=<KartBattle>
requires kart [Drawable3D]
requires battle [KartBattle]
kart.spawn(RenderProvider::Scene3D trim)
trim.Create(1.0, 1.0, 1.0)
trim.SetAnchored(1)
trim.SetVisible(0)
battle.AddTrim(@kart @trim)
