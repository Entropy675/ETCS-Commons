#!/usr/bin/env etcs
# BOWL: open ground, the corners filled in and four low bumpers round the
# middle -- room to chase, little to hide behind. Flat.
#   run kart_map_bowl.etcs battle=<KartBattle>
# AddBlock <x> <z> <width> <depth> <height> <yaw>; AddRamp <x> <z> <yaw> <width>
# <up> <flat> <down> <height>; AddHill <x> <z> <radius> <height> (KartArena.h).
requires battle [KartBattle]
battle.AddMap(bowl)

battle.AddBlock(24.5, 24.5, 1.2, 22.0, 1.2, -45.0)
battle.AddBlock(24.5, -24.5, 1.2, 22.0, 1.2, 45.0)
battle.AddBlock(-24.5, 24.5, 1.2, 22.0, 1.2, 45.0)
battle.AddBlock(-24.5, -24.5, 1.2, 22.0, 1.2, -45.0)
battle.AddBlock(0.0, 9.0, 4.0, 1.2, 0.8, 0.0)
battle.AddBlock(0.0, -9.0, 4.0, 1.2, 0.8, 0.0)
battle.AddBlock(9.0, 0.0, 1.2, 4.0, 0.8, 0.0)
battle.AddBlock(-9.0, 0.0, 1.2, 4.0, 0.8, 0.0)

battle.AddSpawn(0.0, -24.0)
battle.AddSpawn(0.0, 24.0)
battle.AddSpawn(24.0, 0.0)
battle.AddSpawn(-24.0, 0.0)
battle.AddSpawn(15.0, -15.0)
battle.AddSpawn(-15.0, 15.0)
battle.AddSpawn(15.0, 15.0)
battle.AddSpawn(-15.0, -15.0)

battle.AddPickup(0.0, 0.0)
battle.AddPickup(9.0, 9.0)
battle.AddPickup(-9.0, 9.0)
battle.AddPickup(9.0, -9.0)
battle.AddPickup(-9.0, -9.0)
battle.AddPickup(0.0, 18.0)
