#!/usr/bin/env etcs
# BOWL: a basin -- every wall banked, so you can ride up any side and drop
# back in, the banks meeting in the corners, a mound in the middle with a
# box on top, and a ring of low bumpers round it to dodge behind.
#   run kart_map_bowl.etcs battle=<KartBattle>
# AddBlock <x> <z> <width> <depth> <height> <yaw>; AddRamp <x> <z> <yaw> <width>
# <up> <flat> <down> <height>; AddHill <x> <z> <radius> <height>; AddPad <x> <z>
# <yaw>; AddSpring <x> <z>; AddDeck <x> <z> <width> <depth> <height>; AddPit <x>
# <z> <width> <depth> <deep> (KartArena.h). A ramp rises, and a pad pushes,
# toward its yaw (0 +z, 90 +x, 180 -z, 270 -x); one in a pit stands on its floor.
requires battle [KartBattle]
battle.AddMap(bowl)

# The banks: up to the wall, their lips on it, each the whole wall long, so
# two meet in every corner and the corner is ground like the rest -- a kart
# driven into one rides up and rolls back, with nothing to wedge against.
battle.AddRamp(0.0, 27.5, 0.0, 64.0, 7.0, 0.0, 0.0, 2.0)
battle.AddRamp(0.0, -27.5, 180.0, 64.0, 7.0, 0.0, 0.0, 2.0)
battle.AddRamp(27.5, 0.0, 90.0, 64.0, 7.0, 0.0, 0.0, 2.0)
battle.AddRamp(-27.5, 0.0, 270.0, 64.0, 7.0, 0.0, 0.0, 2.0)
# The mound, and the bumpers round it.
battle.AddHill(0.0, 0.0, 7.0, 1.4)
battle.AddBlock(0.0, 11.0, 4.0, 1.2, 0.8, 0.0)
battle.AddBlock(0.0, -11.0, 4.0, 1.2, 0.8, 0.0)
battle.AddBlock(11.0, 0.0, 1.2, 4.0, 0.8, 0.0)
battle.AddBlock(-11.0, 0.0, 1.2, 4.0, 0.8, 0.0)
battle.AddBlock(8.0, 8.0, 3.0, 1.2, 0.8, 45.0)
battle.AddBlock(-8.0, 8.0, 3.0, 1.2, 0.8, -45.0)
battle.AddBlock(8.0, -8.0, 3.0, 1.2, 0.8, -45.0)
battle.AddBlock(-8.0, -8.0, 3.0, 1.2, 0.8, 45.0)

# Pads round the ring between the bumpers and the banks, pointing round it.
battle.AddPad(14.7, 8.5, 330.0)
battle.AddPad(-8.5, 14.7, 240.0)
battle.AddPad(-14.7, -8.5, 150.0)
battle.AddPad(8.5, -14.7, 60.0)

# A deck in the air over the mound, the middle's box on it, and springs to
# reach it from the ring, and to play on.
battle.AddDeck(0.0, 0.0, 8.0, 8.0, 4.0)
battle.AddSpring(14.0, 0.0)
battle.AddSpring(-14.0, 0.0)
battle.AddSpring(17.0, -17.0)
battle.AddSpring(-17.0, 17.0)

battle.AddSpawn(0.0, -19.0)
battle.AddSpawn(0.0, 19.0)
battle.AddSpawn(19.0, 0.0)
battle.AddSpawn(-19.0, 0.0)
battle.AddSpawn(13.0, -13.0)
battle.AddSpawn(-13.0, 13.0)
battle.AddSpawn(13.0, 13.0)
battle.AddSpawn(-13.0, -13.0)

battle.AddPickup(0.0, 0.0)
battle.AddPickup(0.0, 27.0)
battle.AddPickup(0.0, -27.0)
battle.AddPickup(27.0, 0.0)
battle.AddPickup(-27.0, 0.0)
battle.AddPickup(0.0, 14.0)
battle.AddPickup(0.0, -14.0)
