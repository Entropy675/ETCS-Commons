#!/usr/bin/env etcs
# A burst's smoke: eight puffs for its branches and six clouds for its gaps (kart_smoke.etcs).
#   run kart_smokes.etcs world=<Scene3D> battle=<KartBattle> ember=<Mesh>
requires world [Drawable3D]
requires battle [KartBattle]
requires ember [Mesh]
run kart_smoke.etcs world=world battle=battle ember=ember
