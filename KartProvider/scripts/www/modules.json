    "KartProvider/scripts/kart_map_pillars.etcs",
    "KartProvider/scripts/kart_map_crossroads.etcs",
    "KartProvider/scripts/kart_map_hills.etcs",
    "KartProvider/scripts/kart_map_skatepark.etcs",
    "KartProvider/scripts/kart_pool.etcs",
    "KartProvider/scripts/kart_car.etcs",
    "KartProvider/scripts/kart_wheel.etcs",
    "KartProvider/scripts/kart_pickup.etcs",
    "KartProvider/scripts/kart_shots.etcs",
    "KartProvider/scripts/kart_shot.etcs",
