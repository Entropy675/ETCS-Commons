#!/usr/bin/env etcs
# THE BATTLE ON A CAMERA: the card, the frame counter, how to play, the
# lobby's menu and the board Tab holds up, and the battle bound to the eye it
# steers (behind this runtime's own kart) -- the same for a window and a page.
#   run KartProvider/scripts/kart_play.etcs battle=battle world=world eye=eye
requires battle [KartBattle]
requires world [Drawable3D]
requires eye [Camera]

eye.spawn(RenderProvider::TextLabel card)
card.Create(20)
card.SetText(kart)
card.SetPosition(16, 16)
card.SetColor(1.0, 1.0, 0.85, 1.0)
card.SetBackground(0.0, 0.0, 0.0, 0.45)
card.SetPadding(6)
card.SetOrder(11)
# The frame counter, top right: this runtime's pictures a second, and where
# they are drawn -- gpu (WebGPU, Vulkan) or cpu (the host's raster).
eye.spawn(RenderProvider::TextLabel fps)
fps.Create(16)
fps.SetText(-- fps)
fps.SetPosition(886, 50)
fps.SetColor(0.75, 0.9, 0.8, 1.0)
fps.SetBackground(0.0, 0.0, 0.0, 0.35)
fps.SetPadding(4)
fps.SetOrder(11)
eye.spawn(RenderProvider::TextLabel howto)
howto.Create(16)
howto.SetText(W go / S brake / A D steer / Space fire / Q E look / Tab scores / Esc abandon (host))
howto.SetPosition(16, 724)
howto.SetColor(0.75, 0.9, 0.8, 1.0)
howto.SetBackground(0.0, 0.0, 0.0, 0.35)
howto.SetPadding(4)
howto.SetOrder(11)

# The round's board: sixteen rows, up while Tab is held and in a round's
# results.
run kart_board.etcs eye=eye battle=battle
run kart_board.etcs eye=eye battle=battle
run kart_board.etcs eye=eye battle=battle
run kart_board.etcs eye=eye battle=battle

# The lobby's menu, drawn in the canvas and centred in it: the map, the
# length, your colour and name, and the host's start. The page's own panel
# says the same lines, so either one moves the lobby.
eye.spawn(RenderProvider::Menu menu)
menu.Create(640, 430)
menu.SetOrder(20)

battle.BindWorld(@world)
battle.BindCamera(@eye)
battle.BindCard(@card)
battle.BindFps(@fps)
battle.BindMenu(@menu)
