#!/usr/bin/env etcs
# One shell of a burst's fire: glowing (Scene3D.SetGlow), held, solid to
# nothing. The battle gives it one of its baked trees' meshes, sets it at the
# burst turned as the tree is, swells it and fades it (KartBattle.h). The
# ember shape is only what it is until then.
#   run kart_spark.etcs world=<Scene3D> battle=<KartBattle> ember=<Mesh>
requires world [Drawable3D]
requires battle [KartBattle]
requires ember [Mesh]
world.spawn(RenderProvider::Scene3D spark)
spark.Create(0.5, 0.5, 0.8)
spark.SetMesh(@ember)
spark.SetColor(1.0, 0.7, 0.3, 1.0)
spark.SetGlow(1.6)
spark.SetAnchored(1)
battle.AddSparkNode(@spark)
