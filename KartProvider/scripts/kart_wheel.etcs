#!/usr/bin/env etcs
# A wheel of a kart: a tyre on its side, dark, held in the body's frame (fit
# leaves an anchored member where it was made), hidden until its kart is in
# the arena. Quick to shed the heat the battle hands it -- a third of it a
# tick -- so its mark follows what the tyre is doing.
#   run kart_wheel.etcs wheel=<Scene3D> tyre=<Mesh>
requires wheel [Drawable3D]
requires tyre [Mesh]
wheel.Create(0.46, 0.24, 0.46)
wheel.SetMesh(@tyre)
wheel.SetColor(0.08, 0.08, 0.09, 1.0)
wheel.SetAnchored(1)
wheel.SetEmissivity(20.0)
wheel.SetVisible(0)
