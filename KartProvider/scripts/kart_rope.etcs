# way. `run kart_rope.etcs world=<Scene3D> battle=<KartBattle>`
requires world [Drawable3D]
requires battle [KartBattle]
run kart_mark.etcs world=world battle=battle
run kart_mark.etcs world=world battle=battle
run kart_mark.etcs world=world battle=battle
run kart_mark.etcs world=world battle=battle
run kart_mark.etcs world=world battle=battle
run kart_mark.etcs world=world battle=battle
run kart_mark.etcs world=world battle=battle
run kart_mark.etcs world=world battle=battle
