#!/usr/bin/env etcs
# One tyre's mark: thirty-two segments, laid on the ground as it runs, a rope
# of eighty units of road unless the settings say otherwise.
#   run kart_rope.etcs world=<Scene3D> battle=<KartBattle>
requires world [Drawable3D]
requires battle [KartBattle]
# A tyre's mark in a holder of its own: still between the segments it lays,
# and drawn as one mesh (kart_holder.etcs).
world.spawn(RenderProvider::Scene3D rope)
run kart_holder.etcs holder=rope
run kart_marks.etcs world=rope battle=battle
run kart_marks.etcs world=rope battle=battle
run kart_marks.etcs world=rope battle=battle
run kart_marks.etcs world=rope battle=battle
