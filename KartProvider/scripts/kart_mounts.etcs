tree.MountFile(KartProvider/scripts/kart_map_hills.etcs ACE_ROOT/modules/KartProvider/scripts/kart_map_hills.etcs)
tree.MountFile(KartProvider/scripts/kart_map_skatepark.etcs ACE_ROOT/modules/KartProvider/scripts/kart_map_skatepark.etcs)
tree.MountFile(KartProvider/scripts/kart_pool.etcs ACE_ROOT/modules/KartProvider/scripts/kart_pool.etcs)
tree.MountFile(KartProvider/scripts/kart_car.etcs ACE_ROOT/modules/KartProvider/scripts/kart_car.etcs)
tree.MountFile(KartProvider/scripts/kart_wheel.etcs ACE_ROOT/modules/KartProvider/scripts/kart_wheel.etcs)
tree.MountFile(KartProvider/scripts/kart_pickup.etcs ACE_ROOT/modules/KartProvider/scripts/kart_pickup.etcs)
tree.MountFile(KartProvider/scripts/kart_shots.etcs ACE_ROOT/modules/KartProvider/scripts/kart_shots.etcs)
tree.MountFile(KartProvider/scripts/kart_shot.etcs ACE_ROOT/modules/KartProvider/scripts/kart_shot.etcs)
tree.MountFile(KartProvider/scripts/kart_blast.etcs ACE_ROOT/modules/KartProvider/scripts/kart_blast.etcs)
tree.MountFile(KartProvider/scripts/kart_play.etcs ACE_ROOT/modules/KartProvider/scripts/kart_play.etcs)
tree.MountFile(KartProvider/scripts/kart_board.etcs ACE_ROOT/modules/KartProvider/scripts/kart_board.etcs)
tree.MountFile(KartProvider/scripts/kart_board_row.etcs ACE_ROOT/modules/KartProvider/scripts/kart_board_row.etcs)
tree.MountFile(KartProvider/scripts/kart_keys.etcs ACE_ROOT/modules/KartProvider/scripts/kart_keys.etcs)
