#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── THE KART PAGE'S FILES, for any server that hosts it ────────────────────
#
#     tree.SetMountPrefix(kart)
#     run KartProvider/scripts/kart_mounts.etcs tree=tree
#     tree.SetMountPrefix()
#
# The page and what it stages, each at the path it is fetched from -- the same
# list as www/modules.json's scripts. The runtime (/wasm/) and the marks
# (/favicon/) are the site's, mounted once for every page.

requires tree [FileHtmlPage]

tree.MountFile(index.html ACE_ROOT/modules/KartProvider/scripts/www/index.html)
tree.MountFile(modules.json ACE_ROOT/modules/KartProvider/scripts/www/modules.json)
tree.MountFile(boot_kart.etcs ACE_ROOT/modules/KartProvider/scripts/www/boot_kart.etcs)
tree.MountFile(KartProvider/scripts/kart_arena.etcs ACE_ROOT/modules/KartProvider/scripts/kart_arena.etcs)
tree.MountFile(KartProvider/scripts/kart_wall.etcs ACE_ROOT/modules/KartProvider/scripts/kart_wall.etcs)
tree.MountFile(KartProvider/scripts/kart_block.etcs ACE_ROOT/modules/KartProvider/scripts/kart_block.etcs)
tree.MountFile(KartProvider/scripts/kart_blocks.etcs ACE_ROOT/modules/KartProvider/scripts/kart_blocks.etcs)
tree.MountFile(KartProvider/scripts/kart_slab.etcs ACE_ROOT/modules/KartProvider/scripts/kart_slab.etcs)
tree.MountFile(KartProvider/scripts/kart_slabs.etcs ACE_ROOT/modules/KartProvider/scripts/kart_slabs.etcs)
tree.MountFile(KartProvider/scripts/kart_dome.etcs ACE_ROOT/modules/KartProvider/scripts/kart_dome.etcs)
tree.MountFile(KartProvider/scripts/kart_map_bowl.etcs ACE_ROOT/modules/KartProvider/scripts/kart_map_bowl.etcs)
