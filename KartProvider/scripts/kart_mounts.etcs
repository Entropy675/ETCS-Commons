tree.MountFile(KartProvider/scripts/kart_map_bowl.etcs ACE_ROOT/modules/KartProvider/scripts/kart_map_bowl.etcs)
tree.MountFile(KartProvider/scripts/kart_map_pillars.etcs ACE_ROOT/modules/KartProvider/scripts/kart_map_pillars.etcs)
tree.MountFile(KartProvider/scripts/kart_map_crossroads.etcs ACE_ROOT/modules/KartProvider/scripts/kart_map_crossroads.etcs)
tree.MountFile(KartProvider/scripts/kart_map_hills.etcs ACE_ROOT/modules/KartProvider/scripts/kart_map_hills.etcs)
