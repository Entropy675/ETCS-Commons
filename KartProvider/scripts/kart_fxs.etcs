#!/usr/bin/env etcs
# Eight of the weapons' effects (kart_fx.etcs).
#   run kart_fxs.etcs world=<Scene3D> battle=<KartBattle> ball=<Mesh>
requires world [Drawable3D]
requires battle [KartBattle]
requires ball [Mesh]
run kart_fx.etcs world=world battle=battle ball=ball
run kart_fx.etcs world=world battle=battle ball=ball
run kart_fx.etcs world=world battle=battle ball=ball
run kart_fx.etcs world=world battle=battle ball=ball
run kart_fx.etcs world=world battle=battle ball=ball
run kart_fx.etcs world=world battle=battle ball=ball
run kart_fx.etcs world=world battle=battle ball=ball
run kart_fx.etcs world=world battle=battle ball=ball
