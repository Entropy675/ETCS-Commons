#!/usr/bin/env etcs
# PILLARS: two storeys. On the ground a raised plaza in the middle -- a
# cross with a ramp at each end and a box on every arm -- and eight pillars
# round it; on the pillars, a deck over all of it. From each side a long
# ramp runs in under the deck and up through a cut in it, springs go up
# through it, and any edge is the way down. Deflectors in the corners,
# kickers on the outer ring.
#   run kart_map_pillars.etcs battle=<KartBattle>
# AddBlock <x> <z> <width> <depth> <height> <yaw>; AddRamp <x> <z> <yaw> <width>
# <up> <flat> <down> <height>; AddHill <x> <z> <radius> <height>; AddPad <x> <z>
# <yaw>; AddSpring <x> <z>; AddDeck <x> <z> <width> <depth> <height>; AddPit <x>
# <z> <width> <depth> <deep>; AddPickupUp <x> <z>, a box on the deck over the
# spot (KartArena.h). A ramp rises, and a pad pushes, toward its yaw (0 +z,
# 90 +x, 180 -z, 270 -x); what is in a pit stands on its floor.
requires battle [KartBattle]
battle.AddMap(pillars)

# The plaza: two decks crossing, level at the top.
battle.AddRamp(0.0, 0.0, 0.0, 14.0, 10.0, 16.0, 10.0, 2.4)
battle.AddRamp(0.0, 0.0, 90.0, 14.0, 10.0, 16.0, 10.0, 2.4)
# The pillars, up into the deck: their tops are inside its slab, not under it.
battle.AddBlock(-28.0, -28.0, 4.0, 4.0, 4.75, 0.0)
battle.AddBlock(0.0, -28.0, 4.0, 4.0, 4.75, 0.0)
battle.AddBlock(28.0, -28.0, 4.0, 4.0, 4.75, 0.0)
battle.AddBlock(-28.0, 0.0, 4.0, 4.0, 4.75, 0.0)
battle.AddBlock(28.0, 0.0, 4.0, 4.0, 4.75, 0.0)
battle.AddBlock(-28.0, 28.0, 4.0, 4.0, 4.75, 0.0)
battle.AddBlock(0.0, 28.0, 4.0, 4.0, 4.75, 0.0)
battle.AddBlock(28.0, 28.0, 4.0, 4.0, 4.75, 0.0)
# Up to the deck: from each side a ramp twenty-four long, in from the edge
# and up to the deck's height, each the way round the ring goes; a pad at
# its foot.
battle.AddRamp(24.0, 16.0, 270.0, 8.0, 24.0, 0.0, 0.0, 5.1)
battle.AddRamp(16.0, -24.0, 0.0, 8.0, 24.0, 0.0, 0.0, 5.1)
battle.AddRamp(-24.0, -16.0, 90.0, 8.0, 24.0, 0.0, 0.0, 5.1)
battle.AddRamp(-16.0, 24.0, 180.0, 8.0, 24.0, 0.0, 0.0, 5.1)
battle.AddPad(41.0, 16.0, 270.0)
battle.AddPad(16.0, -41.0, 0.0)
battle.AddPad(-41.0, -16.0, 90.0)
battle.AddPad(-16.0, 41.0, 180.0)
# The upper storey: seventy-two square, a third of the arena, laid in pieces
# round the four ramps -- a cross over the plaza, and what is left of each
# corner beside its ramp.
battle.AddDeck(0.0, 0.0, 24.0, 72.0, 5.1)
battle.AddDeck(24.0, 0.0, 24.0, 24.0, 5.1)
battle.AddDeck(-24.0, 0.0, 24.0, 24.0, 5.1)
battle.AddDeck(24.0, 28.0, 24.0, 16.0, 5.1)
battle.AddDeck(28.0, -24.0, 16.0, 24.0, 5.1)
battle.AddDeck(-24.0, -28.0, 24.0, 16.0, 5.1)
battle.AddDeck(-28.0, 24.0, 16.0, 24.0, 5.1)
# Up through it: a spring on the plaza and two on the floor under it.
battle.AddSpring(0.0, 0.0)
battle.AddSpring(21.0, 25.0)
battle.AddSpring(-21.0, -25.0)
# Low deflectors across each corner: cover for whoever spawns behind.
battle.AddBlock(40.0, 40.0, 12.0, 2.0, 1.4, 45.0)
battle.AddBlock(-40.0, 40.0, 12.0, 2.0, 1.4, -45.0)
battle.AddBlock(40.0, -40.0, 12.0, 2.0, 1.4, -45.0)
battle.AddBlock(-40.0, -40.0, 12.0, 2.0, 1.4, 45.0)
# Kickers round the outer ring, each the way round it goes.
battle.AddRamp(52.0, 20.0, 0.0, 6.0, 8.0, 0.0, 0.0, 2.0)
battle.AddRamp(20.0, -52.0, 90.0, 6.0, 8.0, 0.0, 0.0, 2.0)
battle.AddRamp(-52.0, -20.0, 180.0, 6.0, 8.0, 0.0, 0.0, 2.0)
battle.AddRamp(-20.0, 52.0, 270.0, 6.0, 8.0, 0.0, 0.0, 2.0)

battle.AddSpawn(-52.0, -52.0)
battle.AddSpawn(52.0, 52.0)
battle.AddSpawn(52.0, -52.0)
battle.AddSpawn(-52.0, 52.0)
battle.AddSpawn(0.0, -52.0)
battle.AddSpawn(0.0, 52.0)
battle.AddSpawn(52.0, 0.0)
battle.AddSpawn(-52.0, 0.0)

# Boxes on the plaza, and on the deck over it.
battle.AddPickup(0.0, 12.0)
battle.AddPickup(0.0, -12.0)
battle.AddPickup(12.0, 0.0)
battle.AddPickup(-12.0, 0.0)
battle.AddPickup(0.0, 0.0)
battle.AddPickupUp(0.0, 0.0)
battle.AddPickupUp(24.0, -24.0)
battle.AddPickupUp(-24.0, 24.0)
