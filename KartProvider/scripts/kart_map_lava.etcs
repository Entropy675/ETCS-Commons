#!/usr/bin/env etcs
# LAVA: a pool of it in the middle, and a kart that goes in is out. An island
# in the pool with a causeway to each shore; over the island a deck, and a
# scaffold from it over each causeway -- two ways across, to two heights. Two
# ring roads in the air round it all: one over the shore, one higher along
# the arena's wall, and a ramp up to each from every side.
#   run kart_map_lava.etcs battle=<KartBattle>
# AddBlock <x> <z> <width> <depth> <height> <yaw>; AddRamp <x> <z> <yaw> <width>
# <up> <flat> <down> <height>; AddHill <x> <z> <radius> <height>; AddPad <x> <z>
# <yaw>; AddSpring <x> <z>; AddDeck <x> <z> <width> <depth> <height>; AddPit <x>
# <z> <width> <depth> <deep>; AddPickupUp <x> <z>, a box on the deck over the
# spot (KartArena.h). A ramp rises, and a pad pushes, toward its yaw (0 +z,
# 90 +x, 180 -z, 270 -x); what is in a pit stands on its floor.
# AddLava <x> <z> <width> <depth> <deep> is a pit of lava; a ramp in it that is
# all level top, as high as the lava is deep, is ground across it.
requires battle [KartBattle]
battle.AddMap(lava)

# The pool: seventy-two square, three deep, and nothing to climb out by.
battle.AddLava(0.0, 0.0, 72.0, 72.0, 3.0)
# In it, as high as it is deep: the island, and a causeway six wide to the
# middle of each shore. No rails.
battle.AddRamp(0.0, 0.0, 0.0, 24.0, 0.0, 24.0, 0.0, 3.0)
battle.AddRamp(0.0, 24.0, 0.0, 6.0, 0.0, 24.0, 0.0, 3.0)
battle.AddRamp(24.0, 0.0, 90.0, 6.0, 0.0, 24.0, 0.0, 3.0)
battle.AddRamp(0.0, -24.0, 180.0, 6.0, 0.0, 24.0, 0.0, 3.0)
battle.AddRamp(-24.0, 0.0, 270.0, 6.0, 0.0, 24.0, 0.0, 3.0)
# Pads on the causeways: in to the island from north and south, out from it
# to east and west.
battle.AddPad(0.0, 29.0, 180.0)
battle.AddPad(0.0, -29.0, 0.0)
battle.AddPad(29.0, 0.0, 90.0)
battle.AddPad(-29.0, 0.0, 270.0)
# Over the island, the high spot: a deck five up, and from each of its sides
# a scaffold six wide over the causeway below, out to the inner ring.
battle.AddDeck(0.0, 0.0, 16.0, 16.0, 5.0)
battle.AddDeck(0.0, 22.0, 6.0, 28.0, 5.0)
battle.AddDeck(22.0, 0.0, 28.0, 6.0, 5.0)
battle.AddDeck(0.0, -22.0, 6.0, 28.0, 5.0)
battle.AddDeck(-22.0, 0.0, 28.0, 6.0, 5.0)
# The inner ring road: five up, round the pool's shore -- lava on one side.
# (Each side's piece runs on over one corner.)
battle.AddDeck(4.0, 40.0, 80.0, 8.0, 5.0)
battle.AddDeck(40.0, -4.0, 8.0, 80.0, 5.0)
battle.AddDeck(-4.0, -40.0, 80.0, 8.0, 5.0)
battle.AddDeck(-40.0, 4.0, 8.0, 80.0, 5.0)
# The outer ring road: seven and a half up, along the arena's wall and
# higher than it -- the way out of the arena on one side.
battle.AddDeck(4.0, 60.0, 120.0, 8.0, 7.5)
battle.AddDeck(60.0, -4.0, 8.0, 120.0, 7.5)
battle.AddDeck(-4.0, -60.0, 120.0, 8.0, 7.5)
battle.AddDeck(-60.0, 4.0, 8.0, 120.0, 7.5)
# Between the rings, on every side: a ramp up to each, and a spur on from
# its top beside the ring it is for -- up, straight on, and over onto it.
battle.AddRamp(34.0, 47.0, 270.0, 6.0, 20.0, 0.0, 0.0, 5.0)
battle.AddRamp(47.0, -34.0, 0.0, 6.0, 20.0, 0.0, 0.0, 5.0)
battle.AddRamp(-34.0, -47.0, 90.0, 6.0, 20.0, 0.0, 0.0, 5.0)
battle.AddRamp(-47.0, 34.0, 180.0, 6.0, 20.0, 0.0, 0.0, 5.0)
battle.AddDeck(12.0, 47.0, 24.0, 6.0, 5.0)
battle.AddDeck(47.0, -12.0, 6.0, 24.0, 5.0)
battle.AddDeck(-12.0, -47.0, 24.0, 6.0, 5.0)
battle.AddDeck(-47.0, 12.0, 6.0, 24.0, 5.0)
battle.AddRamp(-29.0, 53.0, 90.0, 6.0, 30.0, 0.0, 0.0, 7.5)
battle.AddRamp(53.0, 29.0, 180.0, 6.0, 30.0, 0.0, 0.0, 7.5)
battle.AddRamp(29.0, -53.0, 270.0, 6.0, 30.0, 0.0, 0.0, 7.5)
battle.AddRamp(-53.0, -29.0, 0.0, 6.0, 30.0, 0.0, 0.0, 7.5)
battle.AddDeck(-2.0, 53.0, 24.0, 6.0, 7.5)
battle.AddDeck(53.0, 2.0, 6.0, 24.0, 7.5)
battle.AddDeck(2.0, -53.0, 24.0, 6.0, 7.5)
battle.AddDeck(-53.0, -2.0, 6.0, 24.0, 7.5)
# Springs: under the inner ring's corners, up through it; and two on the
# island, up to the high spot for a kart going fast enough.
battle.AddSpring(40.0, 40.0)
battle.AddSpring(-40.0, 40.0)
battle.AddSpring(40.0, -40.0)
battle.AddSpring(-40.0, -40.0)
battle.AddSpring(10.0, 10.0)
battle.AddSpring(-10.0, -10.0)

# In the corners between the rings, and at the head of every causeway.
battle.AddSpawn(50.0, 50.0)
battle.AddSpawn(-50.0, -50.0)
battle.AddSpawn(50.0, -50.0)
battle.AddSpawn(-50.0, 50.0)
battle.AddSpawn(0.0, -40.0)
battle.AddSpawn(0.0, 40.0)
battle.AddSpawn(40.0, 0.0)
battle.AddSpawn(-40.0, 0.0)

# Boxes: the high spot and the island under it; the middle of every scaffold;
# the outer ring's corners; and two on the island's own corners.
battle.AddPickupUp(0.0, 0.0)
battle.AddPickup(0.0, 0.0)
battle.AddPickupUp(0.0, 22.0)
battle.AddPickupUp(0.0, -22.0)
battle.AddPickupUp(22.0, 0.0)
battle.AddPickupUp(-22.0, 0.0)
battle.AddPickupUp(59.0, 59.0)
battle.AddPickupUp(-59.0, 59.0)
battle.AddPickupUp(59.0, -59.0)
battle.AddPickupUp(-59.0, -59.0)
battle.AddPickup(10.0, -10.0)
battle.AddPickup(-10.0, 10.0)
