#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules
# ── LEAVE A BATTLE JOINED ────────────────────────────────────────────────────
#     run KartProvider/scripts/kart_leave.etcs battle=<KartBattle> peer=<Peer>
# The kart goes with the link: presence is withdrawn with it, and the host
# puts the kart back in the pit (a `leave` line of the record).
requires battle [KartBattle]
requires peer [Peer]
battle.Leave()
peer.Close()
