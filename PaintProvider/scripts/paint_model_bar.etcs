m3_export.SetOrder(1)
m3_export.SetBackground(0.16, 0.16, 0.2, 1.0)
layout.AddBox(@m3_export, @bar, 1, 0.0, 1, 0.0)
palette.AddCall(@m3_export, @model, PaintModeler.ExportHere)
m3_export.spawn(RenderProvider::TextLabel m3_word_export)
m3_word_export.Create()
m3_word_export.SetPosition(8, 28)
m3_word_export.SetSize(1)
m3_word_export.SetColor(0.9, 0.9, 0.88, 1.0)
m3_word_export.SetText(export)
m3_word_export.SetOrder(2)
palette.AddCall(@m3_word_export, @model, PaintModeler.ExportHere)
m3_export.spawn(RenderProvider::TextLabel m3_cap_export)
m3_cap_export.Create()
m3_cap_export.SetPosition(8, 46)
m3_cap_export.SetSize(1)
m3_cap_export.SetColor(0.79, 0.71, 0.35, 1.0)
m3_cap_export.SetText(glb)
m3_cap_export.SetOrder(2)
palette.AddCall(@m3_cap_export, @model, PaintModeler.ExportHere)
m3_export.spawn(RenderProvider::PolygonDrawable2D m3_arrow_export)
m3_arrow_export.Create()
m3_arrow_export.AddPoint(30, 0)
m3_arrow_export.AddPoint(60, 12)
m3_arrow_export.AddPoint(0, 12)
m3_arrow_export.SetFill(0.92, 0.92, 0.90, 0.85)
m3_arrow_export.SetOrder(2)
palette.AddCall(@m3_arrow_export, @model, PaintModeler.CycleFormat)
palette.StretchArrow(@m3_arrow_export)
model.BindCaption(export, @m3_cap_export)

# ── what each cell is, in a sentence shown while it is hovered ──────────────
palette.AddHint(@m3_swatch_ink, The colour new parts get and the paint tool puts on, its arrow opens the colour wheel.)
palette.AddHint(@m3_swatch_red, The colour new parts get and the paint tool puts on, its arrow opens the colour wheel.)
palette.AddHint(@m3_swatch_amber, The colour new parts get and the paint tool puts on, its arrow opens the colour wheel.)
palette.AddHint(@m3_swatch_green, The colour new parts get and the paint tool puts on, its arrow opens the colour wheel.)
palette.AddHint(@m3_swatch_blue, The colour new parts get and the paint tool puts on, its arrow opens the colour wheel.)
palette.AddHint(@m3_swatch_paper, The colour new parts get and the paint tool puts on, its arrow opens the colour wheel.)
palette.AddHint(@m3_tool_select, Click a part to choose it, or drag one of its arrows to slide it along that axis.)
palette.AddHint(@m3_tool_move, Drag a part across the view, or drag one of its arrows to slide it along that axis only.)
palette.AddHint(@m3_tool_turn, Drag sideways to turn a part, about one of its arrows if you grab it.)
palette.AddHint(@m3_tool_size, Drag up or down to grow or shrink a part, along one of its arrows if you grab it.)
palette.AddHint(@m3_tool_add, Click the floor or a part to set a new part of the chosen shape there.)
palette.AddHint(@m3_tool_paint, Click a part to give it the colour in hand.)
palette.AddHint(@m3_tool_delete, Click a part to remove it.)
palette.AddHint(@m3_shape, The shape the add tool makes, or the chosen part has, click to step through them.)
palette.AddHint(@m3_material, What a part is made of, which a game can weigh it by, click to step through them.)
palette.AddHint(@m3_axis, Holds move, turn and size to x, y or z, click to step through them.)
palette.AddHint(@m3_snap, Rounds moves to a quarter unit and turns to fifteen degrees, click to switch it.)
palette.AddHint(@m3_export, Writes the model out as a file in the format shown, its arrow changes the format.)
