# The axis a move slides along, a turn turns about and a size stretches: x, y, z, free. Lit while one is set.
bar.spawn(RenderProvider::CompositeDrawable2D m3_axis)
m3_axis.Create(60, 64)
m3_axis.SetOrder(1)
m3_axis.SetBackground(0.16, 0.16, 0.2, 1.0)
layout.AddBox(@m3_axis, @bar, 1, 0.0, 1, 0.0)
palette.AddCall(@m3_axis, @model, PaintModeler.CycleAxis)
