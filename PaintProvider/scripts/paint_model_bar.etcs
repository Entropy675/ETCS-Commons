m3_word_material.SetPosition(8, 28)
m3_word_material.SetSize(1)
m3_word_material.SetColor(0.9, 0.9, 0.88, 1.0)
m3_word_material.SetText(made)
m3_word_material.SetOrder(2)
palette.AddCall(@m3_word_material, @model, PaintModeler.CycleMaterial)
m3_material.spawn(RenderProvider::TextLabel m3_cap_material)
