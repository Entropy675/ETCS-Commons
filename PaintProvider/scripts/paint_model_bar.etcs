m3_tool_paint.SetOrder(1)
m3_tool_paint.SetBackground(0.16, 0.16, 0.2, 1.0)
layout.AddBox(@m3_tool_paint, @bar, 1, 0.0, 1, 0.0)
palette.AddCall(@m3_tool_paint, @model, PaintModeler.SetTool, paint)
