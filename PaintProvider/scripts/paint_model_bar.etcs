m3_word_axis.Create()
m3_word_axis.SetPosition(8, 28)
m3_word_axis.SetSize(1)
m3_word_axis.SetColor(0.9, 0.9, 0.88, 1.0)
m3_word_axis.SetText(axis)
m3_word_axis.SetOrder(2)
palette.AddCall(@m3_word_axis, @model, PaintModeler.CycleAxis)
m3_axis.spawn(RenderProvider::TextLabel m3_cap_axis)
m3_cap_axis.Create()
m3_cap_axis.SetPosition(8, 46)
m3_cap_axis.SetSize(1)
m3_cap_axis.SetColor(0.79, 0.71, 0.35, 1.0)
m3_cap_axis.SetText(free)
m3_cap_axis.SetOrder(2)
palette.AddCall(@m3_cap_axis, @model, PaintModeler.CycleAxis)
model.BindCell(axis, @m3_axis)
model.BindCaption(axis, @m3_cap_axis)

# A grid to land on: a quarter unit and fifteen degrees. Lit while on.
bar.spawn(RenderProvider::CompositeDrawable2D m3_snap)
m3_snap.Create(60, 64)
m3_snap.SetOrder(1)
m3_snap.SetBackground(0.16, 0.16, 0.2, 1.0)
layout.AddBox(@m3_snap, @bar, 1, 0.0, 1, 0.0)
palette.AddCall(@m3_snap, @model, PaintModeler.ToggleSnap)
m3_snap.spawn(RenderProvider::TextLabel m3_word_snap)
m3_word_snap.Create()
m3_word_snap.SetPosition(8, 28)
m3_word_snap.SetSize(1)
m3_word_snap.SetColor(0.9, 0.9, 0.88, 1.0)
m3_word_snap.SetText(snap)
m3_word_snap.SetOrder(2)
palette.AddCall(@m3_word_snap, @model, PaintModeler.ToggleSnap)
m3_snap.spawn(RenderProvider::TextLabel m3_cap_snap)
m3_cap_snap.Create()
m3_cap_snap.SetPosition(8, 46)
m3_cap_snap.SetSize(1)
m3_cap_snap.SetColor(0.79, 0.71, 0.35, 1.0)
m3_cap_snap.SetText(off)
m3_cap_snap.SetOrder(2)
palette.AddCall(@m3_cap_snap, @model, PaintModeler.ToggleSnap)
model.BindCell(snap, @m3_snap)
model.BindCaption(snap, @m3_cap_snap)

# Out, as a file in the caption's format: the cell writes it, the arrow steps the format.
bar.spawn(RenderProvider::CompositeDrawable2D m3_export)
