bar.spawn(RenderProvider::CompositeDrawable2D m3_tool_delete)
m3_tool_delete.Create(60, 64)
m3_tool_delete.SetOrder(1)
m3_tool_delete.SetBackground(0.16, 0.16, 0.2, 1.0)
layout.AddBox(@m3_tool_delete, @bar, 1, 0.0, 1, 0.0)
palette.AddCall(@m3_tool_delete, @model, PaintModeler.SetTool, delete)
m3_tool_delete.spawn(RenderProvider::TextLabel m3_word_delete)
m3_word_delete.Create()
m3_word_delete.SetPosition(8, 28)
m3_word_delete.SetSize(1)
m3_word_delete.SetColor(0.9, 0.9, 0.88, 1.0)
