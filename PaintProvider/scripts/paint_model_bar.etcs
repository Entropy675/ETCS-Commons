m3_word_size.SetPosition(8, 28)
m3_word_size.SetSize(1)
m3_word_size.SetColor(0.9, 0.9, 0.88, 1.0)
m3_word_size.SetText(size)
m3_word_size.SetOrder(2)
palette.AddCall(@m3_word_size, @model, PaintModeler.SetTool, size)
model.BindCell(size, @m3_tool_size)

bar.spawn(RenderProvider::CompositeDrawable2D m3_tool_add)
m3_tool_add.Create(60, 64)
m3_tool_add.SetOrder(1)
m3_tool_add.SetBackground(0.16, 0.16, 0.2, 1.0)
layout.AddBox(@m3_tool_add, @bar, 1, 0.0, 1, 0.0)
palette.AddCall(@m3_tool_add, @model, PaintModeler.SetTool, add)
m3_tool_add.spawn(RenderProvider::TextLabel m3_word_add)
m3_word_add.Create()
m3_word_add.SetPosition(8, 28)
m3_word_add.SetSize(1)
m3_word_add.SetColor(0.9, 0.9, 0.88, 1.0)
