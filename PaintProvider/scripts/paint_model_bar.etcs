#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# THE 3D BAR: what the page's toolbar row holds while the model is open.
#
#     run paint_model_bar.etcs bar=<Drawable2D> palette=<PaintPalette> model=<PaintModeler> layout=<Layout>
#
# The 2D bar's shape (paint_toolbar.etcs) -- grow cells in a row the
# layout solves, each a compositor with its words as children -- and the same
# row: the two bars take turns at it, since a hidden box takes no room in the
# solve (Clayout::hidden). The swatches are the 2D bar's own six, declared to
# the same palette, so a part is painted with the page's one brush and the
# wheel opens from either bar.
#
# WHAT A PRESS DOES is a verb (palette.AddCall); WHAT A CELL SHOWS is the
# modeller's (PaintModeler::BindCell / BindCaption): the tool in hand is lit,
# a stepper's caption says its value. A word is bound to the same verb as its
# cell, since a label is a child and a press on it picks the label.

requires bar     [Drawable2D]
requires palette [PaintPalette]
requires model   [PaintModeler]
requires layout  [Layout]

# ── the colours: the 2D bar's six, the same brush ───────────────────────────
bar.spawn(RenderProvider::CompositeDrawable2D m3_swatch_ink)
m3_swatch_ink.Create(60, 64)
m3_swatch_ink.SetOrder(1)
m3_swatch_ink.SetBackground(0.1, 0.1, 0.12, 1.0)
layout.AddBox(@m3_swatch_ink, @bar, 1, 0.0, 1, 0.0)
palette.AddColor(@m3_swatch_ink, 0.1, 0.1, 0.12, 1.0)
run paint_cell_arrow.etcs cell=m3_swatch_ink palette=palette

bar.spawn(RenderProvider::CompositeDrawable2D m3_swatch_red)
m3_swatch_red.Create(60, 64)
m3_swatch_red.SetOrder(1)
m3_swatch_red.SetBackground(0.85, 0.18, 0.22, 1.0)
layout.AddBox(@m3_swatch_red, @bar, 1, 0.0, 1, 0.0)
palette.AddColor(@m3_swatch_red, 0.85, 0.18, 0.22, 1.0)
run paint_cell_arrow.etcs cell=m3_swatch_red palette=palette

bar.spawn(RenderProvider::CompositeDrawable2D m3_swatch_amber)
m3_swatch_amber.Create(60, 64)
m3_swatch_amber.SetOrder(1)
m3_swatch_amber.SetBackground(0.95, 0.66, 0.15, 1.0)
layout.AddBox(@m3_swatch_amber, @bar, 1, 0.0, 1, 0.0)
palette.AddColor(@m3_swatch_amber, 0.95, 0.66, 0.15, 1.0)
run paint_cell_arrow.etcs cell=m3_swatch_amber palette=palette

bar.spawn(RenderProvider::CompositeDrawable2D m3_swatch_green)
m3_swatch_green.Create(60, 64)
m3_swatch_green.SetOrder(1)
m3_swatch_green.SetBackground(0.22, 0.62, 0.35, 1.0)
layout.AddBox(@m3_swatch_green, @bar, 1, 0.0, 1, 0.0)
palette.AddColor(@m3_swatch_green, 0.22, 0.62, 0.35, 1.0)
run paint_cell_arrow.etcs cell=m3_swatch_green palette=palette

bar.spawn(RenderProvider::CompositeDrawable2D m3_swatch_blue)
m3_swatch_blue.Create(60, 64)
m3_swatch_blue.SetOrder(1)
m3_swatch_blue.SetBackground(0.2, 0.42, 0.8, 1.0)
layout.AddBox(@m3_swatch_blue, @bar, 1, 0.0, 1, 0.0)
palette.AddColor(@m3_swatch_blue, 0.2, 0.42, 0.8, 1.0)
run paint_cell_arrow.etcs cell=m3_swatch_blue palette=palette

bar.spawn(RenderProvider::CompositeDrawable2D m3_swatch_paper)
m3_swatch_paper.Create(60, 64)
m3_swatch_paper.SetOrder(1)
m3_swatch_paper.SetBackground(1.0, 1.0, 1.0, 1.0)
layout.AddBox(@m3_swatch_paper, @bar, 1, 0.0, 1, 0.0)
palette.AddColor(@m3_swatch_paper, 1.0, 1.0, 1.0, 1.0)
run paint_cell_arrow.etcs cell=m3_swatch_paper palette=palette

# ── what a press on the model does ──────────────────────────────────────────
bar.spawn(RenderProvider::CompositeDrawable2D m3_tool_select)
m3_tool_select.Create(60, 64)
m3_tool_select.SetOrder(1)
m3_tool_select.SetBackground(0.16, 0.16, 0.2, 1.0)
layout.AddBox(@m3_tool_select, @bar, 1, 0.0, 1, 0.0)
palette.AddCall(@m3_tool_select, @model, PaintModeler.SetTool, select)
m3_tool_select.spawn(RenderProvider::TextLabel m3_word_select)
m3_word_select.Create()
m3_word_select.SetPosition(8, 28)
m3_word_select.SetSize(1)
m3_word_select.SetColor(0.9, 0.9, 0.88, 1.0)
m3_word_select.SetText(select)
m3_word_select.SetOrder(2)
palette.AddCall(@m3_word_select, @model, PaintModeler.SetTool, select)
model.BindCell(select, @m3_tool_select)

bar.spawn(RenderProvider::CompositeDrawable2D m3_tool_move)
m3_tool_move.Create(60, 64)
m3_tool_move.SetOrder(1)
m3_tool_move.SetBackground(0.16, 0.16, 0.2, 1.0)
layout.AddBox(@m3_tool_move, @bar, 1, 0.0, 1, 0.0)
palette.AddCall(@m3_tool_move, @model, PaintModeler.SetTool, move)
m3_tool_move.spawn(RenderProvider::TextLabel m3_word_move)
m3_word_move.Create()
m3_word_move.SetPosition(8, 28)
m3_word_move.SetSize(1)
m3_word_move.SetColor(0.9, 0.9, 0.88, 1.0)
m3_word_move.SetText(move)
m3_word_move.SetOrder(2)
palette.AddCall(@m3_word_move, @model, PaintModeler.SetTool, move)
model.BindCell(move, @m3_tool_move)

