m3_tool_turn.Create(60, 64)
m3_tool_turn.SetOrder(1)
m3_tool_turn.SetBackground(0.16, 0.16, 0.2, 1.0)
layout.AddBox(@m3_tool_turn, @bar, 1, 0.0, 1, 0.0)
palette.AddCall(@m3_tool_turn, @model, PaintModeler.SetTool, turn)
m3_tool_turn.spawn(RenderProvider::TextLabel m3_word_turn)
m3_word_turn.Create()
m3_word_turn.SetPosition(8, 28)
m3_word_turn.SetSize(1)
m3_word_turn.SetColor(0.9, 0.9, 0.88, 1.0)
m3_word_turn.SetText(turn)
m3_word_turn.SetOrder(2)
palette.AddCall(@m3_word_turn, @model, PaintModeler.SetTool, turn)
model.BindCell(turn, @m3_tool_turn)

bar.spawn(RenderProvider::CompositeDrawable2D m3_tool_size)
m3_tool_size.Create(60, 64)
m3_tool_size.SetOrder(1)
m3_tool_size.SetBackground(0.16, 0.16, 0.2, 1.0)
layout.AddBox(@m3_tool_size, @bar, 1, 0.0, 1, 0.0)
palette.AddCall(@m3_tool_size, @model, PaintModeler.SetTool, size)
m3_tool_size.spawn(RenderProvider::TextLabel m3_word_size)
