# ── the steppers: the word says what it is, the caption what it is now ──────
#
# The shape add makes, and outside the add tool the chosen part's; the arrow
# and the cell both step it round.
bar.spawn(RenderProvider::CompositeDrawable2D m3_shape)
m3_shape.Create(60, 64)
m3_shape.SetOrder(1)
m3_shape.SetBackground(0.16, 0.16, 0.2, 1.0)
layout.AddBox(@m3_shape, @bar, 1, 0.0, 1, 0.0)
palette.AddCall(@m3_shape, @model, PaintModeler.CycleShape)
m3_shape.spawn(RenderProvider::TextLabel m3_word_shape)
m3_word_shape.Create()
m3_word_shape.SetPosition(8, 28)
m3_word_shape.SetSize(1)
m3_word_shape.SetColor(0.9, 0.9, 0.88, 1.0)
m3_word_shape.SetText(shape)
m3_word_shape.SetOrder(2)
palette.AddCall(@m3_word_shape, @model, PaintModeler.CycleShape)
m3_shape.spawn(RenderProvider::TextLabel m3_cap_shape)
m3_cap_shape.Create()
m3_cap_shape.SetPosition(8, 46)
m3_cap_shape.SetSize(1)
m3_cap_shape.SetColor(0.79, 0.71, 0.35, 1.0)
m3_cap_shape.SetText(box)
m3_cap_shape.SetOrder(2)
palette.AddCall(@m3_cap_shape, @model, PaintModeler.CycleShape)
m3_shape.spawn(RenderProvider::PolygonDrawable2D m3_arrow_shape)
m3_arrow_shape.Create()
m3_arrow_shape.AddPoint(30, 0)
m3_arrow_shape.AddPoint(60, 12)
m3_arrow_shape.AddPoint(0, 12)
m3_arrow_shape.SetFill(0.92, 0.92, 0.90, 0.85)
m3_arrow_shape.SetOrder(2)
palette.AddCall(@m3_arrow_shape, @model, PaintModeler.CycleShape)
palette.StretchArrow(@m3_arrow_shape)
model.BindCaption(shape, @m3_cap_shape)

# The material add makes a part of, and outside the add tool the chosen
