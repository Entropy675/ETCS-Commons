m3_cap_material.SetSize(1)
m3_cap_material.SetColor(0.79, 0.71, 0.35, 1.0)
m3_cap_material.SetText(-)
m3_cap_material.SetOrder(2)
palette.AddCall(@m3_cap_material, @model, PaintModeler.CycleMaterial)
m3_material.spawn(RenderProvider::PolygonDrawable2D m3_arrow_material)
m3_arrow_material.Create()
