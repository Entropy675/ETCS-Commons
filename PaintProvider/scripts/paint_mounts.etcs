#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── WHAT THE PAINT PAGE NEEDS ON THE SERVER ──────────────────────────────────
#
#     run PaintProvider/scripts/paint_mounts.etcs tree=<FileHtmlPage>
#
# Every file the page stages that is not already under www/ -- the scripts it
# runs, the fonts its text boxes use, the frame pump and the terminal it embeds
# from the other modules -- mounted on the tree at the paths the page asks for
# them by (www/modules.json is the list the page fetches; this is the list a
# server answers, and the two change together).
#
# ONE LIST, HERE, beside the files it names. It used to be written out three
# times -- serve_paint.etcs, and ETCS's scripts/run_website.etcs and
# run_tls_website.etcs -- so a new script meant three edits, two of them in
# another repository. Now a server says WHERE the page lives and runs this:
#
#     tree.SetMountPrefix(paint)          -- the site serves the page at /paint
#     run PaintProvider/scripts/paint_mounts.etcs tree=tree
#     tree.SetMountPrefix()
#
# and serve_paint.etcs, which serves nothing else, runs it with no prefix.
# (A prefix rather than an argument because `run` carries RIDs, not words --
# FileHtmlPage::SetMountPrefix.)

requires tree [FileHtmlPage]

tree.MountFile(paint_routed_pointer.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_routed_pointer.etcs)
tree.MountFile(PaintProvider/scripts/paint_toolbar.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_toolbar.etcs)
tree.MountFile(PaintProvider/scripts/paint_wheel.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_wheel.etcs)
tree.MountFile(PaintProvider/scripts/paint_menu.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_menu.etcs)
tree.MountFile(PaintProvider/scripts/paint_layers.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_layers.etcs)
tree.MountFile(PaintProvider/scripts/paint_import.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_import.etcs)
tree.MountFile(PaintProvider/scripts/paint_visitors.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_visitors.etcs)
tree.MountFile(PaintProvider/scripts/paint_eye.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_eye.etcs)
tree.MountFile(PaintProvider/scripts/paint_cell_arrow.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_cell_arrow.etcs)
tree.MountFile(PaintProvider/scripts/paint_layer_row.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_layer_row.etcs)
tree.MountFile(PaintProvider/scripts/paint_page_row.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_page_row.etcs)
tree.MountFile(PaintProvider/scripts/paint_anim.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_anim.etcs)
tree.MountFile(PaintProvider/scripts/paint_anim_row.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_anim_row.etcs)
tree.MountFile(PaintProvider/scripts/paint_visitor_row.etcs ACE_ROOT/modules/PaintProvider/scripts/paint_visitor_row.etcs)
tree.MountFile(RenderProvider/scripts/render_frames.etcs ACE_ROOT/modules/RenderProvider/scripts/render_frames.etcs)
tree.MountFile(shell ACE_ROOT/modules/ShellProvider/scripts/www/index.html)
