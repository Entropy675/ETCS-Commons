#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules
# The shapes a part can be drawn as, by name: RenderProvider Meshes, each in
# the unit box a part's extent scales (RenderProvider/Mesh.h). "box" is every
# node's own and is not made here. A shape another page wants is a Mesh and a
# line like the last of each block -- nothing in the modeller names these four.
# Children of the model's container: a shape is named by where it is
# (Scene3D::SetMesh), so it lives above every part drawn with it.
#   run paint_model_shapes.etcs world=<Scene3D> model=<PaintModeler>
requires world [Drawable3D]
requires model [PaintModeler]

world.spawn(RenderProvider::Mesh sphere)
sphere.Create()
sphere.Sphere(16)
model.AddShape(sphere, @sphere)

world.spawn(RenderProvider::Mesh cylinder)
cylinder.Create()
cylinder.Cylinder(24)
model.AddShape(cylinder, @cylinder)

# A pyramid and a ramp, filled by RenderProvider's shape scripts -- wound to
# look out, which no picture depends on (nothing culls) and an exported file does.
world.spawn(RenderProvider::Mesh pyramid)
run ../../RenderProvider/scripts/mesh_pyramid.etcs shape=pyramid
model.AddShape(pyramid, @pyramid)

world.spawn(RenderProvider::Mesh wedge)
run ../../RenderProvider/scripts/mesh_wedge.etcs shape=wedge
model.AddShape(wedge, @wedge)
