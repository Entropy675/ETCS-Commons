#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules
# The shapes a part can be drawn as, by name: RenderProvider Meshes, each in
# the unit box a part's extent scales (RenderProvider/Mesh.h). "box" is every
# node's own and is not made here. A shape another page wants is a Mesh and a
# line like the last of each block -- nothing in the modeller names these four.
# Children of the model's container: a shape is named by where it is
# (Scene3D::SetMesh), so it lives above every part drawn with it.
#   run paint_model_shapes.etcs world=<Scene3D> model=<PaintModeler>
requires world [Drawable3D]
requires model [PaintModeler]

world.spawn(RenderProvider::Mesh sphere)
sphere.Create()
sphere.Sphere(16)
model.AddShape(sphere, @sphere)

world.spawn(RenderProvider::Mesh cylinder)
cylinder.Create()
cylinder.Cylinder(24)
model.AddShape(cylinder, @cylinder)

# Four sides and a base, a normal a face. Wound as Mesh's own shapes are --
# (b - a) x (c - a) points out -- which no picture depends on (nothing culls)
# and an exported file does.
world.spawn(RenderProvider::Mesh pyramid)
pyramid.Create()
pyramid.AddVertex(-0.5, -0.5, -0.5,  0.0, -1.0, 0.0)
pyramid.AddVertex( 0.5, -0.5, -0.5,  0.0, -1.0, 0.0)
pyramid.AddVertex( 0.5, -0.5,  0.5,  0.0, -1.0, 0.0)
pyramid.AddVertex(-0.5, -0.5,  0.5,  0.0, -1.0, 0.0)
pyramid.AddTriangle(0, 1, 2)
pyramid.AddTriangle(0, 2, 3)
pyramid.AddVertex(-0.5, -0.5, -0.5,  0.0, 0.447, -0.894)
pyramid.AddVertex( 0.5, -0.5, -0.5,  0.0, 0.447, -0.894)
pyramid.AddVertex( 0.0,  0.5,  0.0,  0.0, 0.447, -0.894)
pyramid.AddTriangle(4, 6, 5)
pyramid.AddVertex( 0.5, -0.5, -0.5,  0.894, 0.447, 0.0)
pyramid.AddVertex( 0.5, -0.5,  0.5,  0.894, 0.447, 0.0)
pyramid.AddVertex( 0.0,  0.5,  0.0,  0.894, 0.447, 0.0)
pyramid.AddTriangle(7, 9, 8)
pyramid.AddVertex( 0.5, -0.5,  0.5,  0.0, 0.447, 0.894)
pyramid.AddVertex(-0.5, -0.5,  0.5,  0.0, 0.447, 0.894)
pyramid.AddVertex( 0.0,  0.5,  0.0,  0.0, 0.447, 0.894)
pyramid.AddTriangle(10, 12, 11)
pyramid.AddVertex(-0.5, -0.5,  0.5, -0.894, 0.447, 0.0)
pyramid.AddVertex(-0.5, -0.5, -0.5, -0.894, 0.447, 0.0)
pyramid.AddVertex( 0.0,  0.5,  0.0, -0.894, 0.447, 0.0)
pyramid.AddTriangle(13, 15, 14)
model.AddShape(pyramid, @pyramid)

# A ramp: the box with its top front edge taken off.
world.spawn(RenderProvider::Mesh wedge)
wedge.Create()
wedge.AddVertex(-0.5, -0.5, -0.5,  0.0, -1.0, 0.0)
wedge.AddVertex( 0.5, -0.5, -0.5,  0.0, -1.0, 0.0)
wedge.AddVertex( 0.5, -0.5,  0.5,  0.0, -1.0, 0.0)
wedge.AddVertex(-0.5, -0.5,  0.5,  0.0, -1.0, 0.0)
wedge.AddTriangle(0, 1, 2)
wedge.AddTriangle(0, 2, 3)
wedge.AddVertex(-0.5, -0.5,  0.5,  0.0, 0.0, 1.0)
wedge.AddVertex( 0.5, -0.5,  0.5,  0.0, 0.0, 1.0)
wedge.AddVertex( 0.5,  0.5,  0.5,  0.0, 0.0, 1.0)
wedge.AddVertex(-0.5,  0.5,  0.5,  0.0, 0.0, 1.0)
wedge.AddTriangle(4, 5, 6)
wedge.AddTriangle(4, 6, 7)
wedge.AddVertex(-0.5, -0.5, -0.5,  0.0, 0.707, -0.707)
wedge.AddVertex( 0.5, -0.5, -0.5,  0.0, 0.707, -0.707)
wedge.AddVertex( 0.5,  0.5,  0.5,  0.0, 0.707, -0.707)
wedge.AddVertex(-0.5,  0.5,  0.5,  0.0, 0.707, -0.707)
wedge.AddTriangle(8, 10, 9)
wedge.AddTriangle(8, 11, 10)
wedge.AddVertex(-0.5, -0.5, -0.5, -1.0, 0.0, 0.0)
wedge.AddVertex(-0.5, -0.5,  0.5, -1.0, 0.0, 0.0)
wedge.AddVertex(-0.5,  0.5,  0.5, -1.0, 0.0, 0.0)
wedge.AddTriangle(12, 13, 14)
wedge.AddVertex( 0.5, -0.5, -0.5,  1.0, 0.0, 0.0)
wedge.AddVertex( 0.5, -0.5,  0.5,  1.0, 0.0, 0.0)
wedge.AddVertex( 0.5,  0.5,  0.5,  1.0, 0.0, 0.0)
wedge.AddTriangle(15, 17, 16)
model.AddShape(wedge, @wedge)
