menu_w_word.Create()
menu_w_word.SetPosition(8, 26)
menu_w_word.SetSize(1)
menu_w_word.SetColor(0.80, 0.80, 0.84, 1.0)
menu_w_word.SetText(width)
menu_w_word.SetOrder(2)

pane.spawn(RenderProvider::PolygonDrawable2D menu_w_minus)
menu_w_minus.Create()
menu_w_minus.AddPoint(66, 22)
menu_w_minus.AddPoint(84, 22)
menu_w_minus.AddPoint(84, 38)
menu_w_minus.AddPoint(66, 38)
menu_w_minus.SetFill(0.17, 0.18, 0.13, 1.0)
menu_w_minus.SetOrder(1)
palette.AddCall(@menu_w_minus, @menu, PaintCanvasMenu.StepWidth, -64)
