menu_w_minus_word.SetOrder(2)
palette.AddCall(@menu_w_minus_word, @menu, PaintCanvasMenu.StepWidth, -64)

# The readout. Whatever it says here is overwritten the moment it is bound:
# PaintCanvasMenu pushes the pending value on every change and on the bind.
