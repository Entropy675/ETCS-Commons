# ── the pages kept in the store ──────────────────────────────────────────────
#
# Every `new` saves the page it leaves and opens a fresh one (ApplyNew), and
# `save` puts the present in its slot, so the list below is the session's
# history: newest first, the one on screen highlighted, with the picture the
# store took at save time beside each name. The rows are the layer window's
# bargain (paint_page_row.etcs, one file run per row); PaintPagePanel maps
# them to load, rename and delete, and the wheel over the list scrolls it a
# row per notch (PaintInput::RouteEvent) -- five rows is the resident set, not
# how many pages there can be.

pane.spawn(RenderProvider::TextLabel menu_pages_word)
menu_pages_word.Create()
menu_pages_word.SetPosition(8, 250)
menu_pages_word.SetSize(1)
menu_pages_word.SetColor(0.79, 0.71, 0.35, 1.0)
menu_pages_word.SetText(pages)
menu_pages_word.SetOrder(2)

# The list's own pane: what the wheel is tested against, and the origin every
# row is placed in. Five rows of 26 with 2 between.
pane.spawn(RenderProvider::CompositeDrawable2D pages_pane)
pages_pane.Create(184, 140)
pages_pane.SetPosition(8, 266)
pages_pane.SetOrder(1)
pages.BindWindow(@pages_pane)
pages.SetRowColors(0.35, 0.55, 0.95, 0.15, 0.16, 0.11)

pages_pane.spawn(RenderProvider::CompositeDrawable2D page_row0)
page_row0.Create(184, 26)
page_row0.SetPosition(0, 0)
page_row0.SetOrder(1)
page_row0.SetBackground(0.15, 0.16, 0.11, 1.0)
run paint_page_row.etcs pane=page_row0 list=pages

pages_pane.spawn(RenderProvider::CompositeDrawable2D page_row1)
page_row1.Create(184, 26)
page_row1.SetPosition(0, 28)
page_row1.SetOrder(1)
page_row1.SetBackground(0.15, 0.16, 0.11, 1.0)
run paint_page_row.etcs pane=page_row1 list=pages

