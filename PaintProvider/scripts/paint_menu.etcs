#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── THE PALETTE IS THE RULER'S ───────────────────────────────────────────────
#
# Every ground and button colour in this file comes off the edge ruler rather
# than off the canvas: the band is 0.106/0.110/0.078 (PaintSurface::m_ruler_bg),
# a control is one step up from it, the ink is 0.94/0.89/0.78 (m_ruler_ink) and
# anything selected takes the ruler's in-band highlight, 0.35/0.55/0.95.
# paint_layers.etcs has the argument (furniture should not be the colour of the
# picture); this file just inherits the values.

# THE SETTINGS MENU: what the gear in the sheet's top-left corner opens.
#
#     run PaintProvider/scripts/paint_menu.etcs pane=<Drawable2D> palette=<PaintPalette> menu=<PaintCanvasMenu>
#
# Like the toolbar, the LOOK is here and the MEANING is C++ -- but this panel
# needs no kind of its own in PaintPalette: every control is a rectangle bound
# to a verb with AddCall (node, target, Tag.Action, args), so what a press does
# is written next to the thing you press it on. PaintCanvasMenu holds the
# pending width, height and anchor, pushes the two numbers back onto the
# readouts bound here, and paints the chosen anchor cell -- the script never
# has to keep any of that in step.
#
# Coordinates are the pane's own (200x224), so moving the pane moves the menu.
# Rectangles at order 1, their words at order 2 so the fill does not hide them;
# a word is bound to the same verb as its rectangle, since a label is a sibling
# rather than a child and a press on it picks the label.

requires pane    [Drawable2D]
requires palette [PaintPalette]
requires menu    [PaintCanvasMenu]
requires pages   [PaintPagePanel]

pane.spawn(RenderProvider::TextLabel menu_title)
menu_title.Create()
menu_title.SetPosition(8, 6)
menu_title.SetSize(1)
menu_title.SetColor(0.79, 0.71, 0.35, 1.0)
menu_title.SetText(canvas)
menu_title.SetOrder(2)

# ── width ────────────────────────────────────────────────────────────────────
