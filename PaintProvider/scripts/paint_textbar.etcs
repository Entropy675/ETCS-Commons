#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── THE TEXT BAR ─────────────────────────────────────────────────────────────
#
#     run PaintProvider/scripts/paint_textbar.etcs pane=<Drawable2D> bar=<PaintTextBar> palette=<PaintPalette>
#
# What opens over a text box while it is open: [pixel sans serif mono hand]
# [- size +] [eight colours] [x] [ok]. The fonts are the numbers PaintFonts gave
# them in boot_paint_panels.etcs (the pixel font is 0, then the files in the
# order they were loaded). `ok` lets the box go -- the edit is recorded then,
# as one step of undo -- and `x` removes it.
#
# Every control is a palette call naming a PaintTextBar verb with the node
# pressed, so a press here is the palette's and never reaches the canvas: using
# the bar does not count as the press elsewhere that closes the box.
#
# Colours are the edge ruler's, like every other window: the band
# 0.106/0.110/0.078, a control one step up, the ink 0.94/0.89/0.78.

requires pane    [Drawable2D]
requires bar     [PaintTextBar]
requires palette [PaintPalette]

bar.SetFontTints(0.17, 0.18, 0.13, 0.35, 0.55, 0.95)

pane.spawn(RenderProvider::PolygonDrawable2D tb_font_pixel)
tb_font_pixel.Create()
tb_font_pixel.AddPoint(4, 4)
tb_font_pixel.AddPoint(44, 4)
tb_font_pixel.AddPoint(44, 24)
tb_font_pixel.AddPoint(4, 24)
tb_font_pixel.SetFill(0.17, 0.18, 0.13, 1.0)
tb_font_pixel.SetOrder(2)
bar.BindFont(@tb_font_pixel, 0)
palette.AddCall(@tb_font_pixel, @bar, PaintTextBar.PickFont, @tb_font_pixel)

pane.spawn(RenderProvider::TextLabel tb_font_pixel_word)
tb_font_pixel_word.Create()
tb_font_pixel_word.SetPosition(9, 10)
tb_font_pixel_word.SetSize(1)
tb_font_pixel_word.SetColor(0.94, 0.89, 0.78, 1.0)
tb_font_pixel_word.SetText(pixel)
tb_font_pixel_word.SetOrder(3)
palette.AddCall(@tb_font_pixel_word, @bar, PaintTextBar.PickFont, @tb_font_pixel)

