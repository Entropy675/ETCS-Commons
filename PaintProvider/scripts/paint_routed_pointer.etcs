#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# The pointer channel for a session with MORE THAN ONE PANE, on its own thread.
#
#     detach paint_routed_pointer.etcs window=<Window> router=<PaintRouter>
#
# Identical in shape to paint_pointer.etcs -- same producer, same channel, one
# `->` statement -- and differing only in what is on the far end. There the
# consumer is a PaintInput, which draws wherever the pointer is; here it is a
# PaintRouter, which decides WHICH pane the pointer is over before anything
# interprets it (PaintRouter's own header note on why two PaintInputs on one
# producer is not a division of labour).
#
# Two files rather than a parameter, because the two are not variants of one
# thing: `requires` states which family the far end must be, and a script that
# accepted either would be claiming the choice does not matter. It does -- the
# unrouted form is the right one for a single-pane session and is what
# paint_surface.etcs still uses.

requires window [Window]
requires router [PaintRouter]

window.ProducePointer() -> router.ConsumePointer()
