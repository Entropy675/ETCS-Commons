#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# The pointer channel for a ROUTED paint session, on its own thread.
#
#     detach paint_routed_pointer.etcs window=<Window> input=<PaintInput>
#
# The routed twin of paint_pointer.etcs. Same split and the same reason for it
# -- an edge blocks the thread that states it, and keys must never queue behind
# a burst of positions -- but the consumer translates window coordinates into
# whichever node's frame they landed in before the brush sees them.
#
# It is also what keeps the press channel honest: a key event carries no
# position, so the press edge routes on the last position THIS edge delivered.

requires window [Window]
requires input  [PaintInput]

window.ProducePointer() -> input.ConsumeRoutedPointer()
