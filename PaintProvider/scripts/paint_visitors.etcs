#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── WHO IS IN THE SESSION ────────────────────────────────────────────────────
#
#     run PaintProvider/scripts/paint_visitors.etcs pane=<Drawable2D> palette=<PaintPalette> visitors=<PaintVisitors>
#
# THE LOOK IS HERE, THE MEANING IS C++ -- the same split paint_menu.etcs and
# paint_toolbar.etcs already use. This file draws eight rows and binds their
# three buttons to PaintVisitors verbs with the ROW INDEX as the argument; the
# runtime fills the two labels on each row from the node's roster and hides the
# rows nobody is standing in.
#
# EIGHT, AND THE NUMBER IS THE POINT. A fixed pool means a roster change costs
# no allocation and no spawning on a timer, which is what PaintLayerPanel's
# rows already do. A session with more than eight people shows the first eight;
# a scroll is the same verb the layer panel has and is not built here yet.
#
# THE BUTTONS ARE PALETTE CALLS, not a second panel type on the input path --
# AddCall(node, target, Tag.Action, args) is how every control in the menu works,
# so a press on a row's button is routed by the machinery that is already there.
#
# Colours come off the edge ruler like every other piece of furniture: the band
# is 0.106/0.110/0.078, a control one step up from it, the ink 0.94/0.89/0.78.

requires pane      [Drawable2D]
requires palette   [PaintPalette]
requires visitors  [PaintVisitors]

# ── the title, and the close that ends the session ───────────────────────────
#
# CLOSING THIS WINDOW CLOSES THE SHARE. That is the whole gesture: there is no
# separate 'stop sharing', because a visitor list that is up IS the statement
# that the canvas is shared, and taking it down is the statement that it is not.
# Everyone keeps the canvas they have -- it is theirs, and a copy of this one.
pane.spawn(RenderProvider::TextLabel vis_title)
vis_title.Create()
vis_title.SetPosition(10, 8)
vis_title.SetSize(1)
vis_title.SetColor(0.79, 0.71, 0.35, 1.0)
vis_title.SetText(sharing)
vis_title.SetOrder(2)

pane.spawn(RenderProvider::PolygonDrawable2D vis_close)
vis_close.Create()
vis_close.AddPoint(270, 6)
vis_close.AddPoint(290, 6)
vis_close.AddPoint(290, 24)
vis_close.AddPoint(270, 24)
vis_close.SetFill(0.32, 0.18, 0.16, 1.0)
vis_close.SetOrder(1)
palette.AddCall(@vis_close, @visitors, PaintVisitors.Close, 0)
pane.spawn(RenderProvider::TextLabel vis_close_word)
vis_close_word.Create()
vis_close_word.SetPosition(274, 11)
vis_close_word.SetSize(1)
vis_close_word.SetColor(0.94, 0.89, 0.78, 1.0)
vis_close_word.SetText(x)
vis_close_word.SetOrder(2)
palette.AddCall(@vis_close_word, @visitors, PaintVisitors.Close, 0)

# ── the rows ─────────────────────────────────────────────────────────────────
#
# Each row: a plate, the name, the role, and three controls -- let write, read
# only, remove. All three exist on every row and the runtime decides nothing
# about which to show: a roster that changed a button's presence under the
# pointer would move the other two out from under it mid-click.

# EIGHT PANES, ONE SCRIPT -- the same shape the layer window uses, and for the
# same reason: `run` carries RIDs and not numbers, so a row script cannot be
# told where to draw, but it can be handed a pane that is already there.

pane.spawn(RenderProvider::CompositeDrawable2D vrow0)
vrow0.Create(288, 26)
vrow0.SetPosition(6, 34)
vrow0.SetOrder(1)
vrow0.SetBackground(0.14, 0.15, 0.11, 1.0)
#
# NAMED AS A SIBLING, not by its path from the module root, and that is not a
# style choice. resolve_script_path tries the caller's OWN directory first and
# falls back to the caller's #IMPORT target; a nested run spelled
# "PaintProvider/scripts/x.etcs" from inside PaintProvider/scripts/ asks for
# PaintProvider/scripts/PaintProvider/scripts/x.etcs, misses, and is saved only
# by the #IMPORT fallback -- which exists natively and does NOT in the browser,
# where the scripts are staged into MEMFS at their relative paths and ACE_ROOT
# means nothing. Spelled as a sibling it resolves on the FIRST candidate in both
# places. A top-level run from the boot script still names the full path,
# because from there it is not a sibling.
run paint_visitor_row.etcs pane=vrow0 palette=palette visitors=visitors

pane.spawn(RenderProvider::CompositeDrawable2D vrow1)
vrow1.Create(288, 26)
vrow1.SetPosition(6, 64)
vrow1.SetOrder(1)
vrow1.SetBackground(0.14, 0.15, 0.11, 1.0)
run paint_visitor_row.etcs pane=vrow1 palette=palette visitors=visitors

pane.spawn(RenderProvider::CompositeDrawable2D vrow2)
vrow2.Create(288, 26)
vrow2.SetPosition(6, 94)
vrow2.SetOrder(1)
vrow2.SetBackground(0.14, 0.15, 0.11, 1.0)
run paint_visitor_row.etcs pane=vrow2 palette=palette visitors=visitors

pane.spawn(RenderProvider::CompositeDrawable2D vrow3)
vrow3.Create(288, 26)
vrow3.SetPosition(6, 124)
vrow3.SetOrder(1)
vrow3.SetBackground(0.14, 0.15, 0.11, 1.0)
run paint_visitor_row.etcs pane=vrow3 palette=palette visitors=visitors

pane.spawn(RenderProvider::CompositeDrawable2D vrow4)
vrow4.Create(288, 26)
vrow4.SetPosition(6, 154)
vrow4.SetOrder(1)
vrow4.SetBackground(0.14, 0.15, 0.11, 1.0)
run paint_visitor_row.etcs pane=vrow4 palette=palette visitors=visitors

pane.spawn(RenderProvider::CompositeDrawable2D vrow5)
vrow5.Create(288, 26)
vrow5.SetPosition(6, 184)
vrow5.SetOrder(1)
vrow5.SetBackground(0.14, 0.15, 0.11, 1.0)
run paint_visitor_row.etcs pane=vrow5 palette=palette visitors=visitors

pane.spawn(RenderProvider::CompositeDrawable2D vrow6)
vrow6.Create(288, 26)
vrow6.SetPosition(6, 214)
vrow6.SetOrder(1)
vrow6.SetBackground(0.14, 0.15, 0.11, 1.0)
run paint_visitor_row.etcs pane=vrow6 palette=palette visitors=visitors

pane.spawn(RenderProvider::CompositeDrawable2D vrow7)
vrow7.Create(288, 26)
vrow7.SetPosition(6, 244)
vrow7.SetOrder(1)
vrow7.SetBackground(0.14, 0.15, 0.11, 1.0)
run paint_visitor_row.etcs pane=vrow7 palette=palette visitors=visitors


visitors.SetInk(0.79, 0.71, 0.35, 0.55, 0.57, 0.50)
