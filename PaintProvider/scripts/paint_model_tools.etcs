#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# THE MODEL'S TOOLS: a column of words down the left of the 3D pane.
#
#     run PaintProvider/scripts/paint_model_tools.etcs pane=<Drawable2D> palette=<PaintPalette> model=<PaintModeler>
#
# The canvas menu's bargain (paint_menu.etcs): the LOOK is here and the MEANING
# is a verb. Every control is a TextLabel with a ground, bound with AddCall
# (node, target, Tag.Action, args), so what a press does is written beside the
# thing pressed and PaintModeler never learns it has buttons. A label is its
# own plate here -- one node a control, so one binding.
#
# Coordinates are the pane's own. Order 10: over the camera, which is order 1,
# so a press on a word is the word's and anywhere else is the model's.
#
# The colours are the ruler's (paint_menu.etcs has the argument). What a part
# is painted with is not here at all: it is the page's brush, so the swatches
# and the wheel on the bar below already choose it.

requires pane    [Drawable2D]
requires palette [PaintPalette]
requires model   [PaintModeler]

# ── back to the page ─────────────────────────────────────────────────────────
pane.spawn(RenderProvider::TextLabel m3_back)
m3_back.Create(16)
m3_back.SetPosition(8, 8)
m3_back.SetPadding(4)
m3_back.SetColor(0.106, 0.11, 0.078, 1.0)
m3_back.SetBackground(0.79, 0.71, 0.35, 0.92)
m3_back.SetText(2d page)
m3_back.SetOrder(10)
palette.AddCall(@m3_back, @model, PaintModeler.Close)

