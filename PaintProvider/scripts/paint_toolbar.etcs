#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# Toolbar: full-height slices (960x64). Labels use order 2 so they draw ABOVE
# the slice rects (order 1); otherwise the opaque fill hides the text.

requires bar     [Drawable2D]
requires palette [PaintPalette]

bar.spawn(RenderProvider::PolygonDrawable2D swatch_ink)
swatch_ink.Create()
swatch_ink.AddPoint(0, 0)
swatch_ink.AddPoint(60, 0)
swatch_ink.AddPoint(60, 64)
swatch_ink.AddPoint(0, 64)
swatch_ink.SetFill(0.1, 0.1, 0.12, 1.0)
swatch_ink.SetOrder(1)
palette.AddColor(@swatch_ink, 0.1, 0.1, 0.12, 1.0)

