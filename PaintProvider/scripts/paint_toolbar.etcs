#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# A toolbar, built out of shapes and registered as meanings.
#
#     run paint_toolbar.etcs bar=<Drawable2D> palette=<PaintPalette>
#
# EVERY SWATCH IS AN ORDINARY RECTANGLE in the caller's 2D tree, and that is
# the whole design. PaintProvider owns no raster backend and grows none for a
# row of coloured squares: RenderProvider's shape leaf already knows how to
# draw one, where it is, and whether a point is on it. What PaintProvider adds
# is the only part that is about painting -- this node means that colour --
# and PaintPalette is that mapping and nothing else.
#
# So the appearance of the toolbar is a SCRIPT. Rearranging it, restyling it,
# adding a swatch or replacing the whole row with a colour wheel from a third
# module is an edit to this file and to no C++ at all.
#
# NAMES NO ABSOLUTE POSITION, like every component here: each swatch is placed
# in `bar`'s space, so moving the bar moves the toolbar with nothing here
# recomputed, and the input that finds these nodes arrives already translated
# into the same space they were laid out in (Drawable2D_::PickAt).

requires bar     [Drawable2D]
requires palette [PaintPalette]

# ── the colours ──────────────────────────────────────────────────────────
#
# 44x44 at y=8, sixteen apart. Stated as four corners rather than as a rect
# because a polygon leaf is the general shape and a rectangle is the case of
# it everyone reaches for first.

bar.spawn(RenderProvider::PolygonDrawable2D swatch_ink)
swatch_ink.Create()
swatch_ink.AddPoint(16, 8)
swatch_ink.AddPoint(60, 8)
swatch_ink.AddPoint(60, 52)
swatch_ink.AddPoint(16, 52)
swatch_ink.SetFill(0.10, 0.10, 0.12, 1.0)
swatch_ink.SetOrder(1)
palette.AddColor(@swatch_ink, 0.10, 0.10, 0.12, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D swatch_red)
swatch_red.Create()
swatch_red.AddPoint(76, 8)
swatch_red.AddPoint(120, 8)
swatch_red.AddPoint(120, 52)
swatch_red.AddPoint(76, 52)
swatch_red.SetFill(0.85, 0.18, 0.22, 1.0)
swatch_red.SetOrder(1)
palette.AddColor(@swatch_red, 0.85, 0.18, 0.22, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D swatch_amber)
swatch_amber.Create()
swatch_amber.AddPoint(136, 8)
swatch_amber.AddPoint(180, 8)
swatch_amber.AddPoint(180, 52)
swatch_amber.AddPoint(136, 52)
swatch_amber.SetFill(0.95, 0.66, 0.15, 1.0)
swatch_amber.SetOrder(1)
palette.AddColor(@swatch_amber, 0.95, 0.66, 0.15, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D swatch_green)
swatch_green.Create()
swatch_green.AddPoint(196, 8)
swatch_green.AddPoint(240, 8)
swatch_green.AddPoint(240, 52)
swatch_green.AddPoint(196, 52)
swatch_green.SetFill(0.22, 0.62, 0.35, 1.0)
swatch_green.SetOrder(1)
palette.AddColor(@swatch_green, 0.22, 0.62, 0.35, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D swatch_blue)
swatch_blue.Create()
swatch_blue.AddPoint(256, 8)
swatch_blue.AddPoint(300, 8)
swatch_blue.AddPoint(300, 52)
swatch_blue.AddPoint(256, 52)
swatch_blue.SetFill(0.20, 0.42, 0.80, 1.0)
swatch_blue.SetOrder(1)
palette.AddColor(@swatch_blue, 0.20, 0.42, 0.80, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D swatch_paper)
swatch_paper.Create()
swatch_paper.AddPoint(316, 8)
swatch_paper.AddPoint(360, 8)
swatch_paper.AddPoint(360, 52)
swatch_paper.AddPoint(316, 52)
swatch_paper.SetFill(1.0, 1.0, 1.0, 1.0)
swatch_paper.SetOrder(1)
# White IS the eraser here, and honestly so: the ink layer composites over an
# opaque sheet, so painting the paper's colour is what erasing looks like from
# the outside. A real eraser is a different blend mode, which is a tool change
# rather than a colour change and belongs in PaintTool when it exists.
palette.AddColor(@swatch_paper, 1.0, 1.0, 1.0, 1.0)

# ── the nibs ─────────────────────────────────────────────────────────────
#
# Drawn at the size they select, so the button IS the preview. Squares rather
# than circles because the shape leaf takes points and a circle is a lot of
# them for a thing whose only job is to say "this big".

# ── the tools ────────────────────────────────────────────────────────────
#
# A tool button is a rectangle that MEANS a tool, exactly as a swatch is one
# that means a colour -- same node, same pick, same Apply. What varies between
# the eight is the shape of the whole gesture (PaintToolKind), not which nib is
# loaded, so selecting one leaves the colour and the radius alone.
#
# Drawn as small glyph-ish marks rather than labels: the toolbar is 64 tall and
# a TextLabel at a legible size would not fit beside the swatches. A row of
# distinguishable shapes is enough to pick from, and the log names the tool.

bar.spawn(RenderProvider::PolygonDrawable2D tool_brush)
tool_brush.Create()
tool_brush.AddPoint(620, 12)
tool_brush.AddPoint(644, 12)
tool_brush.AddPoint(644, 36)
tool_brush.AddPoint(620, 36)
tool_brush.SetFill(0.55, 0.55, 0.62, 1.0)
tool_brush.SetOrder(1)
palette.AddTool(@tool_brush, brush)

bar.spawn(RenderProvider::PolygonDrawable2D tool_line)
tool_line.Create()
tool_line.AddPoint(652, 12)
tool_line.AddPoint(676, 12)
tool_line.AddPoint(676, 36)
tool_line.AddPoint(652, 36)
tool_line.SetFill(0.45, 0.60, 0.80, 1.0)
tool_line.SetOrder(1)
palette.AddTool(@tool_line, line)

bar.spawn(RenderProvider::PolygonDrawable2D tool_rect)
tool_rect.Create()
tool_rect.AddPoint(684, 12)
tool_rect.AddPoint(708, 12)
tool_rect.AddPoint(708, 36)
tool_rect.AddPoint(684, 36)
tool_rect.SetFill(0.40, 0.70, 0.60, 1.0)
tool_rect.SetOrder(1)
palette.AddTool(@tool_rect, rect)

bar.spawn(RenderProvider::PolygonDrawable2D tool_ellipse)
tool_ellipse.Create()
tool_ellipse.AddPoint(716, 12)
tool_ellipse.AddPoint(740, 12)
tool_ellipse.AddPoint(740, 36)
tool_ellipse.AddPoint(716, 36)
tool_ellipse.SetFill(0.70, 0.55, 0.80, 1.0)
tool_ellipse.SetOrder(1)
palette.AddTool(@tool_ellipse, ellipse)

bar.spawn(RenderProvider::PolygonDrawable2D tool_fill)
tool_fill.Create()
tool_fill.AddPoint(748, 12)
tool_fill.AddPoint(772, 12)
tool_fill.AddPoint(772, 36)
tool_fill.AddPoint(748, 36)
tool_fill.SetFill(0.85, 0.65, 0.25, 1.0)
tool_fill.SetOrder(1)
palette.AddTool(@tool_fill, fill)

bar.spawn(RenderProvider::PolygonDrawable2D tool_smudge)
tool_smudge.Create()
tool_smudge.AddPoint(780, 12)
tool_smudge.AddPoint(804, 12)
tool_smudge.AddPoint(804, 36)
tool_smudge.AddPoint(780, 36)
tool_smudge.SetFill(0.60, 0.50, 0.45, 1.0)
tool_smudge.SetOrder(1)
palette.AddTool(@tool_smudge, smudge)

bar.spawn(RenderProvider::PolygonDrawable2D tool_ruler)
tool_ruler.Create()
tool_ruler.AddPoint(812, 12)
tool_ruler.AddPoint(836, 12)
tool_ruler.AddPoint(836, 36)
tool_ruler.AddPoint(812, 36)
tool_ruler.SetFill(0.95, 0.80, 0.20, 1.0)
tool_ruler.SetOrder(1)
palette.AddTool(@tool_ruler, ruler)

bar.spawn(RenderProvider::PolygonDrawable2D tool_glyph)
tool_glyph.Create()
tool_glyph.AddPoint(844, 12)
tool_glyph.AddPoint(868, 12)
tool_glyph.AddPoint(868, 36)
tool_glyph.AddPoint(844, 36)
tool_glyph.SetFill(0.90, 0.90, 0.94, 1.0)
tool_glyph.SetOrder(1)
palette.AddTool(@tool_glyph, glyph)


# ── tool labels ──────────────────────────────────────────────────────────
#
# Short TextLabel under each tool. Coloured rects alone are hard to tell
# apart; the built-in 5x8 font at cell scale 1 fits under a 24px button.

bar.spawn(RenderProvider::TextLabel label_brush)
label_brush.Create()
label_brush.SetPosition(620, 40)
label_brush.SetSize(1)
label_brush.SetColor(0.90, 0.90, 0.88, 1.0)
label_brush.SetText(brush)
label_brush.SetOrder(2)

bar.spawn(RenderProvider::TextLabel label_line)
label_line.Create()
label_line.SetPosition(654, 40)
label_line.SetSize(1)
label_line.SetColor(0.90, 0.90, 0.88, 1.0)
label_line.SetText(line)
label_line.SetOrder(2)

bar.spawn(RenderProvider::TextLabel label_rect)
label_rect.Create()
label_rect.SetPosition(686, 40)
label_rect.SetSize(1)
label_rect.SetColor(0.90, 0.90, 0.88, 1.0)
label_rect.SetText(rect)
label_rect.SetOrder(2)

bar.spawn(RenderProvider::TextLabel label_ellipse)
label_ellipse.Create()
label_ellipse.SetPosition(716, 40)
label_ellipse.SetSize(1)
label_ellipse.SetColor(0.90, 0.90, 0.88, 1.0)
label_ellipse.SetText(oval)
label_ellipse.SetOrder(2)

bar.spawn(RenderProvider::TextLabel label_fill)
label_fill.Create()
label_fill.SetPosition(750, 40)
label_fill.SetSize(1)
label_fill.SetColor(0.90, 0.90, 0.88, 1.0)
label_fill.SetText(fill)
label_fill.SetOrder(2)

bar.spawn(RenderProvider::TextLabel label_smudge)
label_smudge.Create()
label_smudge.SetPosition(780, 40)
label_smudge.SetSize(1)
label_smudge.SetColor(0.90, 0.90, 0.88, 1.0)
label_smudge.SetText(smear)
label_smudge.SetOrder(2)

bar.spawn(RenderProvider::TextLabel label_ruler)
label_ruler.Create()
label_ruler.SetPosition(812, 40)
label_ruler.SetSize(1)
label_ruler.SetColor(0.90, 0.90, 0.88, 1.0)
label_ruler.SetText(rule)
label_ruler.SetOrder(2)

bar.spawn(RenderProvider::TextLabel label_glyph)
label_glyph.Create()
label_glyph.SetPosition(846, 40)
label_glyph.SetSize(1)
label_glyph.SetColor(0.90, 0.90, 0.88, 1.0)
label_glyph.SetText(text)
label_glyph.SetOrder(2)

bar.spawn(RenderProvider::PolygonDrawable2D nib_fine)
nib_fine.Create()
nib_fine.AddPoint(420, 26)
nib_fine.AddPoint(426, 26)
nib_fine.AddPoint(426, 32)
nib_fine.AddPoint(420, 32)
nib_fine.SetFill(0.85, 0.85, 0.88, 1.0)
nib_fine.SetOrder(1)
palette.AddSize(@nib_fine, 3.0)

bar.spawn(RenderProvider::PolygonDrawable2D nib_medium)
nib_medium.Create()
nib_medium.AddPoint(452, 20)
nib_medium.AddPoint(466, 20)
nib_medium.AddPoint(466, 34)
nib_medium.AddPoint(452, 34)
nib_medium.SetFill(0.85, 0.85, 0.88, 1.0)
nib_medium.SetOrder(1)
palette.AddSize(@nib_medium, 8.0)

bar.spawn(RenderProvider::PolygonDrawable2D nib_broad)
nib_broad.Create()
nib_broad.AddPoint(492, 12)
nib_broad.AddPoint(520, 12)
nib_broad.AddPoint(520, 40)
nib_broad.AddPoint(492, 40)
nib_broad.SetFill(0.85, 0.85, 0.88, 1.0)
nib_broad.SetOrder(1)
palette.AddSize(@nib_broad, 18.0)

bar.spawn(RenderProvider::PolygonDrawable2D nib_wide)
nib_wide.Create()
nib_wide.AddPoint(548, 6)
nib_wide.AddPoint(590, 6)
nib_wide.AddPoint(590, 48)
nib_wide.AddPoint(548, 48)
nib_wide.SetFill(0.85, 0.85, 0.88, 1.0)
nib_wide.SetOrder(1)
palette.AddSize(@nib_wide, 30.0)
