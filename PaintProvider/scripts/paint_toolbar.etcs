alpha_minus.AddPoint(960, 32)
alpha_minus.AddPoint(960, 64)
alpha_minus.AddPoint(900, 64)
alpha_minus.SetFill(0.16, 0.16, 0.20, 1.0)
alpha_minus.SetOrder(1)
