swatch_paper.AddPoint(360, 0)
swatch_paper.AddPoint(360, 64)
swatch_paper.AddPoint(300, 64)
swatch_paper.SetFill(1.0, 1.0, 1.0, 1.0)
swatch_paper.SetOrder(1)
palette.AddColor(@swatch_paper, 1.0, 1.0, 1.0, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D tool_brush)
tool_brush.Create()
tool_brush.AddPoint(360, 0)
tool_brush.AddPoint(420, 0)
tool_brush.AddPoint(420, 64)
tool_brush.AddPoint(360, 64)
tool_brush.SetFill(0.22, 0.22, 0.26, 1.0)
tool_brush.SetOrder(1)
palette.AddTool(@tool_brush, brush)
bar.spawn(RenderProvider::TextLabel label_brush)
label_brush.Create()
label_brush.SetPosition(368, 28)
label_brush.SetSize(1)
label_brush.SetColor(0.90, 0.90, 0.88, 1.0)
label_brush.SetText(brush)
label_brush.SetOrder(2)
palette.AddTool(@label_brush, brush)

