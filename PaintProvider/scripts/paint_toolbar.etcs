bar.spawn(RenderProvider::PolygonDrawable2D wheel_arrow_green)
wheel_arrow_green.Create()
wheel_arrow_green.AddPoint(210, 3)
wheel_arrow_green.AddPoint(217, 13)
wheel_arrow_green.AddPoint(203, 13)
wheel_arrow_green.SetFill(0.92, 0.92, 0.90, 0.85)
wheel_arrow_green.SetOrder(2)
