bar.spawn(RenderProvider::PolygonDrawable2D radius_plus)
radius_plus.Create()
radius_plus.AddPoint(840, 0)
radius_plus.AddPoint(900, 0)
radius_plus.AddPoint(900, 32)
radius_plus.AddPoint(840, 32)
radius_plus.SetFill(0.16, 0.16, 0.20, 1.0)
radius_plus.SetOrder(1)
palette.AddRadiusDelta(@radius_plus, 3.0)
bar.spawn(RenderProvider::PolygonDrawable2D radius_minus)
radius_minus.Create()
radius_minus.AddPoint(840, 32)
radius_minus.AddPoint(900, 32)
radius_minus.AddPoint(900, 64)
radius_minus.AddPoint(840, 64)
radius_minus.SetFill(0.16, 0.16, 0.20, 1.0)
radius_minus.SetOrder(1)
palette.AddRadiusDelta(@radius_minus, -3.0)
bar.spawn(RenderProvider::TextLabel label_radius_num)
label_radius_num.Create()
label_radius_num.SetPosition(862, 28)
label_radius_num.SetSize(1)
label_radius_num.SetColor(0.90, 0.90, 0.88, 1.0)
label_radius_num.SetText(3)
label_radius_num.SetOrder(2)
bar.spawn(RenderProvider::TextLabel label_radius_top)
label_radius_top.Create()
label_radius_top.SetPosition(866, 8)
label_radius_top.SetSize(1)
label_radius_top.SetColor(0.90, 0.90, 0.88, 1.0)
label_radius_top.SetText(+)
label_radius_top.SetOrder(2)
bar.spawn(RenderProvider::TextLabel label_radius_bot)
