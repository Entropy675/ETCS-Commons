bar.spawn(RenderProvider::PolygonDrawable2D wheel_arrow_blue)
wheel_arrow_blue.Create()
wheel_arrow_blue.AddPoint(270, 3)
wheel_arrow_blue.AddPoint(277, 13)
wheel_arrow_blue.AddPoint(263, 13)
wheel_arrow_blue.SetFill(0.92, 0.92, 0.90, 0.85)
wheel_arrow_blue.SetOrder(2)
palette.AddWheelArrow(@wheel_arrow_blue, @swatch_blue)
bar.spawn(RenderProvider::PolygonDrawable2D wheel_arrow_paper)
wheel_arrow_paper.Create()
wheel_arrow_paper.AddPoint(330, 3)
wheel_arrow_paper.AddPoint(337, 13)
wheel_arrow_paper.AddPoint(323, 13)
wheel_arrow_paper.SetFill(0.92, 0.92, 0.90, 0.85)
wheel_arrow_paper.SetOrder(2)
palette.AddWheelArrow(@wheel_arrow_paper, @swatch_paper)

bar.spawn(RenderProvider::PolygonDrawable2D radius_plus)
radius_plus.Create()
radius_plus.AddPoint(840, 0)
radius_plus.AddPoint(900, 0)
radius_plus.AddPoint(900, 32)
radius_plus.AddPoint(840, 32)
radius_plus.SetFill(0.16, 0.16, 0.20, 1.0)
radius_plus.SetOrder(1)
palette.AddRadiusDelta(@radius_plus, 3.0)
bar.spawn(RenderProvider::PolygonDrawable2D radius_minus)
radius_minus.Create()
radius_minus.AddPoint(840, 32)
radius_minus.AddPoint(900, 32)
radius_minus.AddPoint(900, 64)
radius_minus.AddPoint(840, 64)
radius_minus.SetFill(0.16, 0.16, 0.20, 1.0)
radius_minus.SetOrder(1)
palette.AddRadiusDelta(@radius_minus, -3.0)
bar.spawn(RenderProvider::TextLabel label_radius_num)
label_radius_num.Create()
label_radius_num.SetPosition(862, 22)
label_radius_num.SetSize(1)
label_radius_num.SetColor(0.90, 0.90, 0.88, 1.0)
label_radius_num.SetText(3)
label_radius_num.SetOrder(2)
bar.spawn(RenderProvider::TextLabel label_radius_top)
label_radius_top.Create()
label_radius_top.SetPosition(866, 8)
label_radius_top.SetSize(1)
label_radius_top.SetColor(0.90, 0.90, 0.88, 1.0)
label_radius_top.SetText(+)
label_radius_top.SetOrder(2)
bar.spawn(RenderProvider::TextLabel label_radius_bot)
label_radius_bot.Create()
label_radius_bot.SetPosition(866, 48)
label_radius_bot.SetSize(1)
label_radius_bot.SetColor(0.90, 0.90, 0.88, 1.0)
label_radius_bot.SetText(-)
label_radius_bot.SetOrder(2)
# WHAT THE NUMBER IS, under it: two bare numbers at the end of the bar were a
# guess as to which was which.
bar.spawn(RenderProvider::TextLabel label_radius_what)
label_radius_what.Create()
label_radius_what.SetPosition(858, 34)
label_radius_what.SetSize(1)
label_radius_what.SetColor(0.79, 0.71, 0.35, 1.0)
label_radius_what.SetText(size)
label_radius_what.SetOrder(2)
# In the page's gold (--sel) so it is a different colour from the white number
# above it rather than a dimmer one. Always shown: the caption sits between the
# number and the minus, a space nothing else uses.
palette.SetRadiusReadout(@label_radius_num)
palette.AddRadiusDelta(@label_radius_top, 3.0)
palette.AddRadiusDelta(@label_radius_bot, -3.0)

