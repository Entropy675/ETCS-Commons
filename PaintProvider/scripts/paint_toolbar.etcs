#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# Toolbar: full-height slices (960x64). Labels use order 2 so they draw ABOVE
# the slice rects (order 1); otherwise the opaque fill hides the text.

requires bar     [Drawable2D]
requires palette [PaintPalette]

bar.spawn(RenderProvider::PolygonDrawable2D swatch_ink)
swatch_ink.Create()
swatch_ink.AddPoint(0, 0)
swatch_ink.AddPoint(60, 0)
swatch_ink.AddPoint(60, 64)
swatch_ink.AddPoint(0, 64)
swatch_ink.SetFill(0.1, 0.1, 0.12, 1.0)
swatch_ink.SetOrder(1)
palette.AddColor(@swatch_ink, 0.1, 0.1, 0.12, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D swatch_red)
swatch_red.Create()
swatch_red.AddPoint(60, 0)
swatch_red.AddPoint(120, 0)
swatch_red.AddPoint(120, 64)
swatch_red.AddPoint(60, 64)
swatch_red.SetFill(0.85, 0.18, 0.22, 1.0)
swatch_red.SetOrder(1)
palette.AddColor(@swatch_red, 0.85, 0.18, 0.22, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D swatch_amber)
swatch_amber.Create()
swatch_amber.AddPoint(120, 0)
swatch_amber.AddPoint(180, 0)
swatch_amber.AddPoint(180, 64)
swatch_amber.AddPoint(120, 64)
swatch_amber.SetFill(0.95, 0.66, 0.15, 1.0)
swatch_amber.SetOrder(1)
palette.AddColor(@swatch_amber, 0.95, 0.66, 0.15, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D swatch_green)
swatch_green.Create()
swatch_green.AddPoint(180, 0)
swatch_green.AddPoint(240, 0)
swatch_green.AddPoint(240, 64)
swatch_green.AddPoint(180, 64)
swatch_green.SetFill(0.22, 0.62, 0.35, 1.0)
swatch_green.SetOrder(1)
palette.AddColor(@swatch_green, 0.22, 0.62, 0.35, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D swatch_blue)
swatch_blue.Create()
swatch_blue.AddPoint(240, 0)
swatch_blue.AddPoint(300, 0)
swatch_blue.AddPoint(300, 64)
swatch_blue.AddPoint(240, 64)
swatch_blue.SetFill(0.2, 0.42, 0.8, 1.0)
swatch_blue.SetOrder(1)
palette.AddColor(@swatch_blue, 0.2, 0.42, 0.8, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D swatch_paper)
swatch_paper.Create()
swatch_paper.AddPoint(300, 0)
swatch_paper.AddPoint(360, 0)
swatch_paper.AddPoint(360, 64)
swatch_paper.AddPoint(300, 64)
swatch_paper.SetFill(1.0, 1.0, 1.0, 1.0)
swatch_paper.SetOrder(1)
palette.AddColor(@swatch_paper, 1.0, 1.0, 1.0, 1.0)

bar.spawn(RenderProvider::PolygonDrawable2D tool_brush)
tool_brush.Create()
tool_brush.AddPoint(360, 0)
tool_brush.AddPoint(420, 0)
tool_brush.AddPoint(420, 64)
tool_brush.AddPoint(360, 64)
tool_brush.SetFill(0.16, 0.16, 0.20, 1.0)
tool_brush.SetOrder(1)
palette.AddTool(@tool_brush, brush)
bar.spawn(RenderProvider::TextLabel label_brush)
label_brush.Create()
label_brush.SetPosition(368, 28)
label_brush.SetSize(1)
label_brush.SetColor(0.90, 0.90, 0.88, 1.0)
label_brush.SetText(brush)
label_brush.SetOrder(2)
palette.AddTool(@label_brush, brush)

# ── select ───────────────────────────────────────────────────────────────────
#
# One slice, four modes: the word under "select" is the mode in hand, and the
# arrow at the top of the slice steps it (PaintPalette::AddModeArrow -- the same
# arrow a swatch has, doing the one thing a four-way choice needs). Pressing the
# slice itself, either word included, takes the tool up in whatever mode the
# readout shows.
bar.spawn(RenderProvider::PolygonDrawable2D tool_select)
tool_select.Create()
tool_select.AddPoint(420, 0)
tool_select.AddPoint(480, 0)
tool_select.AddPoint(480, 64)
tool_select.AddPoint(420, 64)
tool_select.SetFill(0.16, 0.16, 0.20, 1.0)
tool_select.SetOrder(1)
palette.AddTool(@tool_select, select)
bar.spawn(RenderProvider::TextLabel label_select)
label_select.Create()
label_select.SetPosition(428, 28)
label_select.SetSize(1)
label_select.SetColor(0.90, 0.90, 0.88, 1.0)
label_select.SetText(select)
label_select.SetOrder(2)
palette.AddTool(@label_select, select)
# The readout. "rect" because that is PaintTool's starting mode; the arrow
# rewrites it from then on.
bar.spawn(RenderProvider::TextLabel label_select_mode)
label_select_mode.Create()
label_select_mode.SetPosition(428, 46)
label_select_mode.SetSize(1)
label_select_mode.SetColor(0.70, 0.72, 0.80, 1.0)
label_select_mode.SetText(rect)
label_select_mode.SetOrder(2)
palette.AddTool(@label_select_mode, select)
palette.SetModeReadout(@label_select_mode)
bar.spawn(RenderProvider::PolygonDrawable2D mode_arrow_select)
mode_arrow_select.Create()
mode_arrow_select.AddPoint(450, 3)
mode_arrow_select.AddPoint(457, 13)
mode_arrow_select.AddPoint(443, 13)
mode_arrow_select.SetFill(0.92, 0.92, 0.90, 0.85)
mode_arrow_select.SetOrder(2)
palette.AddModeArrow(@mode_arrow_select, @tool_select)

bar.spawn(RenderProvider::PolygonDrawable2D tool_line)
tool_line.Create()
tool_line.AddPoint(480, 0)
tool_line.AddPoint(540, 0)
tool_line.AddPoint(540, 64)
tool_line.AddPoint(480, 64)
tool_line.SetFill(0.16, 0.16, 0.20, 1.0)
tool_line.SetOrder(1)
palette.AddTool(@tool_line, line)
bar.spawn(RenderProvider::TextLabel label_line)
label_line.Create()
label_line.SetPosition(488, 28)
label_line.SetSize(1)
label_line.SetColor(0.90, 0.90, 0.88, 1.0)
label_line.SetText(line)
label_line.SetOrder(2)
palette.AddTool(@label_line, line)

# ONE SHAPE SLICE where rect and oval were two. They are one gesture -- two
# corners -- and which outline goes between them is a MODE, stepped by the arrow
# at the top exactly as the select slice's is (PaintShapeMode). The name of the
# current outline is a caption under the word, always shown, as the select
# slice's mode is: in the page's gold rather than the readout white, so it reads
# as "what the arrow chose" and not as a second tool name.
bar.spawn(RenderProvider::PolygonDrawable2D tool_shape)
tool_shape.Create()
tool_shape.AddPoint(540, 0)
tool_shape.AddPoint(600, 0)
tool_shape.AddPoint(600, 64)
tool_shape.AddPoint(540, 64)
tool_shape.SetFill(0.16, 0.16, 0.20, 1.0)
tool_shape.SetOrder(1)
palette.AddTool(@tool_shape, shape)
bar.spawn(RenderProvider::TextLabel label_shape)
label_shape.Create()
label_shape.SetPosition(548, 28)
label_shape.SetSize(1)
label_shape.SetColor(0.90, 0.90, 0.88, 1.0)
label_shape.SetText(shape)
label_shape.SetOrder(2)
palette.AddTool(@label_shape, shape)
bar.spawn(RenderProvider::TextLabel label_shape_mode)
label_shape_mode.Create()
label_shape_mode.SetPosition(548, 46)
label_shape_mode.SetSize(1)
label_shape_mode.SetColor(0.79, 0.71, 0.35, 1.0)
label_shape_mode.SetText(rect)
label_shape_mode.SetOrder(2)
palette.AddTool(@label_shape_mode, shape)
palette.SetShapeReadout(@label_shape_mode)
bar.spawn(RenderProvider::PolygonDrawable2D mode_arrow_shape)
mode_arrow_shape.Create()
mode_arrow_shape.AddPoint(570, 3)
mode_arrow_shape.AddPoint(577, 13)
mode_arrow_shape.AddPoint(563, 13)
mode_arrow_shape.SetFill(0.92, 0.92, 0.90, 0.85)
mode_arrow_shape.SetOrder(2)
palette.AddModeArrow(@mode_arrow_shape, @tool_shape)

