label_radius_bot.SetSize(1)
label_radius_bot.SetColor(0.90, 0.90, 0.88, 1.0)
label_radius_bot.SetText(-)
label_radius_bot.SetOrder(2)
palette.SetRadiusReadout(@label_radius_num)
palette.AddRadiusDelta(@label_radius_top, 3.0)
palette.AddRadiusDelta(@label_radius_bot, -3.0)

