list.AddRow(@row4_bg, @row4_eye, @row4_thumb, @row4_name, @row4_del)

panel.spawn(RenderProvider::PolygonDrawable2D row5_bg)
row5_bg.Create()
row5_bg.AddPoint(4, 166)
row5_bg.AddPoint(236, 166)
row5_bg.AddPoint(236, 192)
row5_bg.AddPoint(4, 192)
row5_bg.SetFill(0.15, 0.16, 0.11, 1.0)
row5_bg.SetOrder(1)

panel.spawn(RenderProvider::PolygonDrawable2D row5_eye)
row5_eye.Create()
row5_eye.AddPoint(8, 173)
row5_eye.AddPoint(22, 173)
row5_eye.AddPoint(22, 185)
row5_eye.AddPoint(8, 185)
row5_eye.SetFill(0.94, 0.89, 0.78, 1.0)
row5_eye.SetOrder(2)

panel.spawn(RenderProvider::CompositeDrawable2D row5_thumb)
row5_thumb.Create(24, 24)
row5_thumb.SetPosition(28, 167)
row5_thumb.SetOrder(2)
row5_thumb.SetRetain(1)

panel.spawn(RenderProvider::TextLabel row5_name)
row5_name.Create()
row5_name.SetPosition(58, 173)
row5_name.SetSize(2)
row5_name.SetColor(0.90, 0.90, 0.94, 1.0)
row5_name.SetText(-)
