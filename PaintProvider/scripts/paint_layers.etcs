panel.spawn(RenderProvider::PolygonDrawable2D row3_del)
row3_del.Create()
row3_del.AddPoint(216, 115)
row3_del.AddPoint(232, 115)
row3_del.AddPoint(232, 131)
row3_del.AddPoint(216, 131)
