panel.spawn(RenderProvider::PolygonDrawable2D row4_del)
row4_del.Create()
row4_del.AddPoint(216, 143)
row4_del.AddPoint(232, 143)
row4_del.AddPoint(232, 159)
row4_del.AddPoint(216, 159)
