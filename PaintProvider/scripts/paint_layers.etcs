list.AddRow(@row5_bg, @row5_eye, @row5_thumb, @row5_name, @row5_del)

panel.spawn(RenderProvider::PolygonDrawable2D row6_bg)
row6_bg.Create()
row6_bg.AddPoint(4, 194)
row6_bg.AddPoint(236, 194)
row6_bg.AddPoint(236, 220)
row6_bg.AddPoint(4, 220)
row6_bg.SetFill(0.15, 0.16, 0.11, 1.0)
row6_bg.SetOrder(1)

panel.spawn(RenderProvider::PolygonDrawable2D row6_eye)
row6_eye.Create()
row6_eye.AddPoint(8, 201)
row6_eye.AddPoint(22, 201)
row6_eye.AddPoint(22, 213)
row6_eye.AddPoint(8, 213)
row6_eye.SetFill(0.94, 0.89, 0.78, 1.0)
row6_eye.SetOrder(2)

panel.spawn(RenderProvider::CompositeDrawable2D row6_thumb)
row6_thumb.Create(24, 24)
row6_thumb.SetPosition(28, 195)
row6_thumb.SetOrder(2)
row6_thumb.SetRetain(1)

panel.spawn(RenderProvider::TextLabel row6_name)
row6_name.Create()
row6_name.SetPosition(58, 201)
row6_name.SetSize(2)
row6_name.SetColor(0.90, 0.90, 0.94, 1.0)
row6_name.SetText(-)
row6_name.SetOrder(2)

panel.spawn(RenderProvider::PolygonDrawable2D row6_del)
row6_del.Create()
row6_del.AddPoint(216, 199)
row6_del.AddPoint(232, 199)
row6_del.AddPoint(232, 215)
row6_del.AddPoint(216, 215)
row6_del.SetFill(0.72, 0.31, 0.23, 1.0)
row6_del.SetOrder(2)

list.AddRow(@row6_bg, @row6_eye, @row6_thumb, @row6_name, @row6_del)

# Bind the stack to the rows now that all of them exist. Called again by the
# panel itself after anything that changes what the window should say, so a
# script only has to say it once.
list.Refresh()
