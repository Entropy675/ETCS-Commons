panel.spawn(RenderProvider::PolygonDrawable2D row4_bg)
row4_bg.Create()
row4_bg.AddPoint(4, 138)
row4_bg.AddPoint(236, 138)
row4_bg.AddPoint(236, 164)
row4_bg.AddPoint(4, 164)
row4_bg.SetFill(0.15, 0.16, 0.11, 1.0)
row4_bg.SetOrder(1)

panel.spawn(RenderProvider::PolygonDrawable2D row4_eye)
row4_eye.Create()
row4_eye.AddPoint(8, 145)
row4_eye.AddPoint(22, 145)
row4_eye.AddPoint(22, 157)
row4_eye.AddPoint(8, 157)
row4_eye.SetFill(0.94, 0.89, 0.78, 1.0)
