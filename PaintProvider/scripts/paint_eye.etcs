#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── AN EYE ───────────────────────────────────────────────────────────────────
#
#     run PaintProvider/scripts/paint_eye.etcs pane=<Drawable2D> list=<PaintLayerPanel>
#
# An oval white, an iris centred in it whose top and bottom touch the white's,
# and a pupil in the iris. Drawn at LOCAL coordinates inside whatever pane it is handed,
# which is the only reason one file can serve every row: `run` carries RIDs and
# not numbers (resolve_run_bindings), so a script cannot be told "draw at y=54"
# -- but it can be handed a pane that is already there, and a pane is a
# coordinate origin.
#
# WHY IT IS ITS OWN FILE. The same shape was written out once per row, seven
# times in paint_layers.etcs, which is seven places to change the
# glyph and six of them to forget. A shape is a thing, not a paragraph repeated.
#
# IT REGISTERS ITSELF, into whichever row is currently open (PaintLayerPanel::
# BeginRow). It has to: a script cannot hand its spawned nodes back to its
# caller, so if the caller had to name them this file could not exist.
#
# THE PANEL TINTS THE WHITE AND THE IRIS: the white takes the shown/hidden
# colours (SetEyeColors) and the iris the open/shut ones (SetIrisColors), so an
# open eye has the page's highlight in it and a shut one is a single dark
# shape with its pupil lost in it. All three parts are the eye to a press or a
# hover -- the iris and pupil sit on top and the pick takes the topmost node,
# so an iris that was only decoration made the middle of every eye the one
# place on it that did nothing. Separate nodes because they are three colours
# -- see PaintLayerPanel::RowNode.
#
# ON THE TITLE BAR TOO: run between BeginTitle and the first BeginRow, the same
# two nodes become the window's view toggle, open while the rows show and shut
# while the window is collapsed to its bar.
#
# `list` IS UNTYPED because two windows take an eye: the layer window
# (PaintLayerPanel) and the sharing window (PaintVisitors), whose bar folds
# the same way. Both answer RowNode(what, node) and know which part is which.

requires pane [Drawable2D]
requires list

# OVALS, ALL THREE, and smooth: SetOval fills the true curve and draws the
# pixels its edge crosses at the share of them it covers
# (PolygonDrawable2D::SetOval). Not points: a point list is filled a pixel in or
# out, so a curve through points is a staircase, and a shape ten pixels tall is
# mostly edge.
#
# The white: 22 across and 10 tall, its box at (8, 8) in the row's own space,
# so its centre is (19, 13).
pane.spawn(RenderProvider::PolygonDrawable2D eye)
eye.Create()
eye.SetOval(8, 8, 22, 10)
eye.SetFill(0.94, 0.89, 0.78, 1.0)
eye.SetOrder(2)

# The iris: a circle as tall as the white, so its top and bottom touch it. The
# colour here is only what it is until the panel's first Refresh; the panel
# owns it from then on.
pane.spawn(RenderProvider::PolygonDrawable2D iris)
iris.Create()
iris.SetOval(14, 8, 10, 10)
iris.SetFill(0.35, 0.55, 0.95, 1.0)
iris.SetOrder(3)

# The pupil: a dot in the middle of the iris, which is what makes the shape
# read as an eye rather than as a bead. Dark, and it stays dark: on a shut eye
# the iris sinks to the band's colour and the dot goes with it.
pane.spawn(RenderProvider::PolygonDrawable2D pupil)
pupil.Create()
pupil.SetOval(17, 11, 4, 4)
pupil.SetFill(0.06, 0.06, 0.05, 1.0)
pupil.SetOrder(4)

# Into the open row, or onto the title bar -- the panel knows which is open.
list.RowNode(eye, @eye)
list.RowNode(iris, @iris)
list.RowNode(pupil, @pupil)
