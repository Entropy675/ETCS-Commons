#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# A TEST AUTHORITY: ACE's half of the chain, made in one run, so the machinery
# can be exercised before the real ceremony exists. A super-root, the active
# key under it, and three loaders' keys that share that parent: the build
# server's (marketplace), the release machine's (release) and the site's
# registrar's (registrar). Each is the key `etcs --loader-key` prints for its
# own store; three stores on one machine are three loaders.
#
# Nothing is kept but the certificates, written to AUTHORITY_DIR (which must
# exist and hold none of them: custody never overwrites). Both keys are
# forgotten when this ends, so this authority certifies nothing else. That is
# the difference from the ceremony (root_ceremony.etcs), which shards them.
#
#   for r in marketplace release registrar; do
#       mkdir -p stores/$r
#       eval "${r}_key=\$(ETCS_STORE=$PWD/stores/$r bin/etcs --loader-key | grep -E '^[0-9a-f]{64}$')"
#   done
#   mkdir authority
#   sed -e "s|AUTHORITY_DIR|$PWD/authority|" -e "s|MARKETPLACE_KEY|$marketplace_key|" \
#       -e "s|RELEASE_KEY|$release_key|" -e "s|REGISTRAR_KEY|$registrar_key|" \
#       modules/CryptProvider/scripts/test_authority.etcs > authority.etcs
#   bin/etcs authority.etcs
#
# Then pin authority/root.cert's subject (ACE_ROOT_KEY), rebuild, and give each
# store its half: ETCS_STORE=stores/<role> bin/etcs --registration
#   authority/<role>.cert authority/active.cert authority/root.cert

spawn NetworkProvider::Embassy embassy
spawn CryptProvider::Custody out
spawn NetworkProvider::FileRelation to_out
to_out.Root(AUTHORITY_DIR)
to_out.Target(Directory)
to_out.Activate(@out)
embassy.Advertise(authority file @to_out)
embassy.Open()
out.SetEmbassy(@embassy)
out.SetRelation(authority)

spawn CryptProvider::Keypair super_root
super_root.Generate()
spawn CryptProvider::Certificate super_root_cert
super_root_cert.Issue(@super_root root @super_root)

spawn CryptProvider::Keypair active
active.Generate()
spawn CryptProvider::Certificate active_cert
active_cert.Issue(@super_root intermediate @active)

spawn CryptProvider::Certificate marketplace_cert
marketplace_cert.Issue(@active marketplace MARKETPLACE_KEY)
spawn CryptProvider::Certificate release_cert
release_cert.Issue(@active release RELEASE_KEY)
spawn CryptProvider::Certificate registrar_cert
registrar_cert.Issue(@active registrar REGISTRAR_KEY)

out.Advertise(marketplace cert @marketplace_cert)
out.Advertise(release cert @release_cert)
out.Advertise(registrar cert @registrar_cert)
out.Advertise(active cert @active_cert)
out.Advertise(root cert @super_root_cert)

super_root.Delete()
active.Delete()
embassy.Close()
